# mxtk-lint-rule: conv009_max_microflow_objects
# Shipped by mxcli-project-toolkit. This file REPLACES the same-named rule that
# `mxcli init` seeds into .claude/lint-rules/. Do not hand-edit: tune it through
# .claude/lint-config.yaml (below). `mxcli init` silently overwrites it, and
# sync-project.sh restores it only while the marker line above is present and unmodified.
# See skills/lint-that-actually-runs.md.
# --- end mxtk-lint-rule header ---
# CONV009: Maximum Microflow Objects
#
# A microflow with more objects than the threshold should be split into SUB_ flows.
#
# WHY THIS COPY EXISTS (issue #267). The stock rule (mxcli 0.17.0 to 0.26.0) hard-codes
# `MAX_ACTIVITIES = 15` and never calls get_option(). The lint-config.yaml that `mxcli init`
# writes names this very rule as its options example (`CONV009: options: maxObjects: 20`),
# so a project that follows the example changes nothing: no error, no notice, findings stay
# at 15. Field evidence: three toolkit-built apps had 36 / 30 / 5 findings at 15 and would
# have had 16 / 11 / 2 at 20; one app ran a script whose only job was to split flows below
# 15 to quiet the linter, and the rises were re-baselined in bulk.
#
# Configure in .claude/lint-config.yaml (this is the ONLY way; do not edit this file):
#
#   rules:
#     CONV009:
#       options:
#         maxObjects: 20          # default 15, the stock value
#         countLoopBodies: true   # default false: count objects inside loops too
#
# DEFAULT KEPT AT 15. skills/microflow-preflight.md splits at 20 counting loop bodies;
# changing the default for every project is a maintainer call, so this copy changes only
# that the option is read. `maxObjects: 20` + `countLoopBodies: true` is the preflight rule.
#
# What it counts: `activity_count` = top-level flow objects (actions, splits, loops,
# annotations; not start, end, merge). With countLoopBodies, `total_activity_count`
# (mxcli >= 0.25.0) adds every object inside a loop, at any depth.
#
# SELF-CHECKS (a rule that cannot see must say so, never report a clean pass):
#   - maxObjects / countLoopBodies set to something unusable (a list, text, 0): `_rule`
#     finding, and the rule does not silently fall back to 15.
#   - countLoopBodies on an mxcli without total_activity_count: `_rule` finding.
#   - every flow reports 0 objects, yet activities_for() finds a real object (not a start,
#     end or merge) in one of them: activity_count is not populated. Zero everywhere with
#     nothing behind it is an early greenfield model (empty microflows), not blindness.

RULE_ID = "CONV009"
RULE_NAME = "MaxMicroflowObjects"
DESCRIPTION = "Microflows should not exceed the configured number of objects (default 15; option maxObjects)"
CATEGORY = "quality"
SEVERITY = "info"

DEFAULT_MAX_OBJECTS = 15
# activities_for() rows that activity_count never counts (probed 2026-10-13, mxcli 0.26.0:
# every flow has one StartEvent, empty flows have only start and end).
NOT_COUNTED = ("StartEvent", "EndEvent", "ExclusiveMerge")
# How many zero-count flows to cross-check with activities_for() before calling it.
PROBE_FLOWS = 20


def _blind(msg, suggestion):
    return violation(
        message=msg,
        location=location(module="_rule", document_type="Microflow", document_name="CONV009"),
        suggestion=suggestion,
    )


def _int_option(raw):
    # YAML gives an int; a quoted "20" arrives as text. Anything else is unusable.
    if type(raw) == "int":
        return raw
    if type(raw) == "float" and raw == int(raw):
        return int(raw)
    if type(raw) == "string" and raw.strip().isdigit():
        return int(raw.strip())
    return None


def check():
    violations = []

    raw_max = get_option("maxObjects", DEFAULT_MAX_OBJECTS)
    max_objects = _int_option(raw_max)
    if max_objects == None or max_objects < 1:
        return [_blind(
            "CONV009 option maxObjects is {} ({}), not a positive whole number. This rule inspected NOTHING.".format(repr(raw_max), type(raw_max)),
            "Set `rules: CONV009: options: maxObjects: 20` in .claude/lint-config.yaml (a plain number; a YAML list reaches the rule as None).",
        )]

    nested = get_option("countLoopBodies", False)
    if type(nested) != "bool":
        return [_blind(
            "CONV009 option countLoopBodies is {} ({}), not true / false. This rule inspected NOTHING.".format(repr(nested), type(nested)),
            "Set `countLoopBodies: true` or `false` under `rules: CONV009: options:` in .claude/lint-config.yaml.",
        )]

    flows = microflows()
    if nested and len(flows) > 0 and getattr(flows[0], "total_activity_count", None) == None:
        return [_blind(
            "CONV009 countLoopBodies is on, but this mxcli has no total_activity_count (needs mxcli >= 0.25.0). This rule inspected NOTHING.",
            "Upgrade mxcli, or drop countLoopBodies from .claude/lint-config.yaml.",
        )]

    nonzero = 0
    for mf in flows:
        n = mf.total_activity_count if nested else mf.activity_count
        if n > 0:
            nonzero += 1
        if n <= max_objects:
            continue
        noun_title = getattr(mf, "document_noun_title", "") or "Microflow"
        noun = getattr(mf, "document_noun", "") or "microflow"
        scope = "objects, loop bodies included" if nested else "top-level objects"
        violations.append(violation(
            message="{} '{}' has {} {} (max: {}). Split into sub-{}s.".format(
                noun_title, mf.name, n, scope, max_objects, noun),
            location=location(module=mf.module_name, document_type=noun_title, document_name=mf.qualified_name),
            suggestion="Extract logical sections into SUB_ {}s to keep each at or under {} objects".format(noun, max_objects),
        ))

    if len(flows) > 0 and nonzero == 0:
        for mf in flows[:PROBE_FLOWS]:
            real = [a for a in activities_for(mf.qualified_name) if a.activity_type not in NOT_COUNTED]
            if real:
                violations.append(_blind(
                    "CONV009 blind: all {} flows report 0 objects, but {} has {}: activity_count is not populated on this mxcli.".format(len(flows), mf.qualified_name, len(real)),
                    "Probe: sqlite3 .mxcli/catalog.db \"SELECT ActivityCount, COUNT(*) FROM microflows GROUP BY 1;\" — then upgrade mxcli or report it upstream.",
                ))
                break

    return violations
