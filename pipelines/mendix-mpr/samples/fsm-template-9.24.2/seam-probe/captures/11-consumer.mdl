mdl 1;
create or modify microflow Synchronization.Note_ProcessUpdatingNativeNote (
  @position(-360, 5)
  $Note: Note.Note,
  @position(-360, 95)
  $NativeNote: NativeNote.NativeNote
)
folder 'Objects/Note'
export level api
begin
  @start(-360, 200)
  @position(-195, 200)
  @curve(from: (30, 0), to: (-30, 0))
  $NativeWorkOrder = call microflow NativeMobile.NativeWorkOrder_Get_BySystemID(SystemID = $Note/Note.Note_WorkOrder/TicketManagement.WorkOrder/SystemID, NativeWorkOrderList_optional = empty);
  @position(-25, 200)
  @curve(from: (30, 0), to: (-30, 0))
  $NativeTechnician = call microflow NativeTechnician.NativeTechnician_Get_BySystemID(SystemID = $Note/Note.Note_Technician/Technician.Technician/SystemID, NativeTechnicianList_optional = empty);
  @position(165, 200)
  change $NativeNote (Title = $Note/Title, Description = $Note/Description, SystemID = if $NativeNote/SystemID = empty
then $Note/SystemID
else $NativeNote/SystemID, NativeNote.NativeNote_NativeWorkOrder = $NativeWorkOrder, NativeNote.NativeNote_NativeTechnician = $NativeTechnician, NrOfPictures = $Note/NrOfPictures, ShouldBeSynced = false);
  @position(360, 200)
  $SliceResponse = call rest service post '{1}/rest/seam/v1/notes?SystemID={2}&Title={3}&Description={4}&NrOfPictures={5}' with ({1} = @Synchronization.NoteSliceBaseUrl, {2} = urlEncode($Note/SystemID), {3} = urlEncode(if $Note/Title = empty then '' else $Note/Title), {4} = urlEncode(if $Note/Description = empty then '' else $Note/Description), {5} = toString(if $Note/NrOfPictures = empty then 0 else $Note/NrOfPictures)) (
    Timeout: 30,
  ) returns String;
  log node 'SeamProbe' 'slice answered: {1}' with ({1} = $SliceResponse);
  @position(700, 200)
  return;
end;
  call microflow General.ASU_DemoUserList_CreateIfNeeded();
  @curve(from: (30, 0), to: (-15, 0))
  $Variable = call microflow MendixSSO.MendixSSO_AfterStartup();
  $SeamProbeNote = create Note.Note (SystemID = 'seam-' + formatDateTime([%CurrentDateTime%], 'yyyyMMddHHmmss'), Title = 'Seam probe note', Description = 'created in the FSM monolith', CreatedOn = [%CurrentDateTime%], NrOfPictures = 0);
  @curve(from: (15, 0), to: (-15, 0))
  call microflow Note.Note_Commit(Note = $SeamProbeNote);
  return true;
end;
