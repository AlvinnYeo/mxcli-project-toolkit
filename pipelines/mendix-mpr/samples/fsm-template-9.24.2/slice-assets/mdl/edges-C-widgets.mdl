mdl 1;
-- Legacy Data grid / Reference selector -> Data grid 2 / Combo box: Mendix 11 has only the React client (CE0582).
-- Generated by gen-widgets.py from mxcli bson dump of each page; drift listed at the end.
alter page AssetManagement.Asset_AssetPart_AddToBOM {
  replace grid1 with {
    datagrid grid1 (DataSource: DATABASE Part.Part WHERE [IsActive and not(Part.AssetPart_Part/Part.AssetPart/Part.AssetPart_Asset = $Asset)], Selection: Single) {
      column (Attribute: PartID, Caption: 'Part ID')
      column (Attribute: Name, Caption: 'Name')
      column (Attribute: Description, Caption: 'Description')
      column (Attribute: Part_UnitOfMeasure/UnitName, Caption: 'Unit of measure')
      column (Attribute: Price, Caption: 'Price')
      column (Attribute: Vendor, Caption: 'Vendor')
      column (Caption: ' ') {
        actionbutton actionButton3 (Caption: 'Add To BOM', Action: CALL MICROFLOW AssetManagement.ACT_AssetPart_CreateAndAddToBOM(Asset = $Asset, Part = $currentObject))
      }
    }
  };
};
alter page AssetManagement.Asset_Overview {
  replace grid1 with {
    datagrid grid1 (DataSource: DATABASE AssetManagement.Asset SORT BY AssetID ASC, Selection: Single) {
      column (Attribute: AssetID, Caption: 'Asset ID')
      column (Attribute: Description, Caption: 'Name')
      column (Attribute: Asset_Customer/CustomerName, Caption: 'Customer')
      column (Attribute: Asset_Manufacturer/Name, Caption: 'Manufacturer')
      column (Attribute: Asset_Dossier/Name, Caption: 'Dossier')
      column (Attribute: Address, Caption: 'Address')
      column (Attribute: ZipCode, Caption: 'Zip code')
      column (Attribute: City, Caption: 'City')
      column (Caption: ' ') {
        actionbutton actionButton1 (Caption: 'Open', Action: SHOW PAGE AssetManagement.Asset_View(Asset = $currentObject))
        actionbutton actionButton3 (Caption: 'Delete', Action: CALL MICROFLOW AssetManagement.ACT_Asset_Delete(Asset = $currentObject))
      }
    }
  };
};
alter page AssetManagement.Asset_Select_Multi {
  replace grid1 with {
    datagrid grid1 (DataSource: DATABASE AssetManagement.Asset SORT BY AssetID ASC, Selection: Multi) {
      column (Attribute: AssetID, Caption: 'Asset ID')
      column (Attribute: Description, Caption: 'Name')
      column (Attribute: Address, Caption: 'Address')
      column (Attribute: ZipCode, Caption: 'Zip code')
      column (Attribute: City, Caption: 'City')
    }
  };
};
alter page AssetManagement.Asset_Select_Single {
  replace grid1 with {
    datagrid grid1 (DataSource: DATABASE AssetManagement.Asset SORT BY AssetID ASC, Selection: Single) {
      column (Attribute: AssetID, Caption: 'Asset ID')
      column (Attribute: Description, Caption: 'Name')
      column (Attribute: Address, Caption: 'Address')
      column (Attribute: ZipCode, Caption: 'Zip code')
      column (Attribute: City, Caption: 'City')
    }
  };
};
alter page AssetManagement.Dossier_Select_Multi {
  replace grid1 with {
    datagrid grid1 (DataSource: DATABASE AssetManagement.Dossier SORT BY Name ASC, Selection: Multi) {
      column (Attribute: Name, Caption: 'Name')
    }
  };
};
alter snippet AssetManagement.Snippet_Asset_DataTabs {
  replace grid2 with {
    datagrid grid2 (DataSource: DATABASE CustomerManagement.ContactPerson WHERE [CustomerManagement.ContactPerson_Asset = $Asset] SORT BY Name ASC, Selection: Single) {
      column (Attribute: Name, Caption: 'Name')
      column (Attribute: PhoneNumber, Caption: 'Phone number')
      column (Attribute: EmailAddress, Caption: 'Email')
      column (Attribute: Description, Caption: 'Job description')
      column (Attribute: ContactPerson_Customer/CustomerName, Caption: 'Customer(s)')
      column (Attribute: ContactPerson_Contract/Number, Caption: 'Contract(s)')
      column (Attribute: ContactPerson_Dossier/Name, Caption: 'Dossier(s)')
      column (Caption: ' ') {
        actionbutton actionButton2 (Caption: 'Open', Action: SHOW PAGE CustomerManagement.ContactPerson_View(ContactPerson = $currentObject))
      }
    }
  };
  replace grid3 with {
    datagrid grid3 (DataSource: DATABASE RosterManagement.Roster WHERE [RosterManagement.Roster_Asset = $Asset] SORT BY StartDate ASC, StartTime ASC, Selection: Single) {
      column (Attribute: StartDate, Caption: 'Start date')
      column (Attribute: EndDate, Caption: 'End date')
      column (Attribute: StartTime, Caption: 'Start time')
      column (Attribute: EndTime, Caption: 'End time')
      column (Caption: ' ') {
        actionbutton editButton2 (Caption: 'Edit', Action: SHOW PAGE RosterManagement.Roster_NewEdit(Roster = $currentObject))
        actionbutton deleteButton2 (Caption: 'Delete', Action: CALL MICROFLOW RosterManagement.ACT_Roster_Delete(Roster = $currentObject))
      }
      controlbar {
        actionbutton actionButton3 (Caption: 'New', Action: CALL MICROFLOW AssetManagement.ACT_Asset_CreateRoster(Asset = $Asset))
        actionbutton deleteButton3 (Caption: 'Delete All', Action: CALL MICROFLOW AssetManagement.ACT_Asset_DeleteRosters(Asset = $Asset))
      }
    }
  };
  replace grid1 with {
    datagrid grid1 (DataSource: DATABASE TicketManagement.Ticket WHERE [TicketManagement.Ticket_Asset = $Asset] SORT BY CreationTime DESC, Selection: Single) {
      column (Attribute: TicketID, Caption: 'Ticket ID')
      column (Attribute: CreationTime, Caption: 'Creation date')
      column (Attribute: Description, Caption: 'Description')
      column (Attribute: Ticket_TicketType/Name, Caption: 'Type')
      column (Attribute: NumberOfWorkOrders, Caption: 'Number of work orders')
      column (Attribute: Ticket_Priority/Description, Caption: 'Priority')
      column (Attribute: Status, Caption: 'Status')
      column (Caption: ' ') {
        actionbutton actionButton6 (Caption: 'Open', Action: SHOW PAGE TicketManagement.Ticket_View(Ticket = $currentObject))
      }
    }
  };
  replace grid4 with {
    datagrid grid4 (DataSource: DATABASE Part.AssetPart WHERE [Part.AssetPart_Asset = $Asset], Selection: Multi) {
      column (Attribute: AssetPart_Part/PartID, Caption: 'Part ID')
      column (Attribute: AssetPart_Part/Name, Caption: 'Name')
      column (Attribute: AssetPart_Part/Description, Caption: 'Description')
      column (Attribute: AssetPart_Part/Part_UnitOfMeasure/UnitName, Caption: 'Unit of measure')
      column (Attribute: Quantity, Caption: 'Quantity')
      column (Attribute: AssetPart_Part/Price, Caption: 'Price')
      column (Attribute: AssetPart_Part/Vendor, Caption: 'Vendor')
      controlbar {
        actionbutton actionButton5 (Caption: 'New', Action: CALL MICROFLOW AssetManagement.ACT_AssetPart_AddNew(Asset = $Asset))
        actionbutton actionButton7 (Caption: 'Delete', Action: CALL MICROFLOW AssetManagement.ACT_AssetPart_Delete(AssetPartList_ToDelete = $grid4))
        actionbutton actionButton8 (Caption: 'View Part', Action: CALL MICROFLOW AssetManagement.ACT_AssetPart_ShowPartDetails(AssetPartList = $grid4))
      }
    }
  };
};
alter snippet AssetManagement.Snippet_Asset_Details {
  replace referenceSelector8 with {
    dataview dv_referenceSelector8 (DataSource: $Asset) {
      combobox referenceSelector8 (Label: 'Customer', Association: AssetManagement.Asset_Customer, DataSource: database CustomerManagement.Customer, CaptionAttribute: CustomerName)
    }
  };
  replace referenceSelector3 with {
    dataview dv_referenceSelector3 (DataSource: $Asset) {
      combobox referenceSelector3 (Label: 'Preferred technician', Association: AssetManagement.Asset_Technician_Preferred, DataSource: database Technician.Technician, CaptionAttribute: TechnicianName)
    }
  };
  replace referenceSelector9 with {
    dataview dv_referenceSelector9 (DataSource: $Asset) {
      combobox referenceSelector9 (Label: 'Umbrella contract', Association: AssetManagement.Asset_UmbrellaContract, DataSource: database CustomerManagement.Contract, CaptionAttribute: Description)
    }
  };
  replace referenceSelector10 with {
    dataview dv_referenceSelector10 (DataSource: $Asset) {
      combobox referenceSelector10 (Label: 'Dossier', Association: AssetManagement.Asset_Dossier, DataSource: database AssetManagement.Dossier, CaptionAttribute: Name)
    }
  };
  replace referenceSelector11 with {
    dataview dv_referenceSelector11 (DataSource: $Asset) {
      combobox referenceSelector11 (Label: 'Contract', Association: AssetManagement.Asset_Contract, DataSource: database CustomerManagement.Contract, CaptionAttribute: Description)
    }
  };
  replace referenceSelector12 with {
    dataview dv_referenceSelector12 (DataSource: $Asset) {
      combobox referenceSelector12 (Label: 'Agreement group', Association: AssetManagement.Asset_AgreementGroup, DataSource: database AssetManagement.AgreementGroup, CaptionAttribute: Name)
    }
  };
  replace referenceSelector1 with {
    dataview dv_referenceSelector1 (DataSource: $Asset) {
      combobox referenceSelector1 (Label: 'Manufacturer', Association: AssetManagement.Asset_Manufacturer, DataSource: database AssetManagement.Manufacturer, CaptionAttribute: Name)
    }
  };
  replace referenceSelector2 with {
    dataview dv_referenceSelector2 (DataSource: $Asset) {
      combobox referenceSelector2 (Label: 'Structure', Association: AssetManagement.Asset_Structure, DataSource: database AssetManagement.Structure, CaptionAttribute: Name)
    }
  };
};
alter page Part.Part_Overview {
  replace grid1 with {
    datagrid grid1 (DataSource: DATABASE Part.Part SORT BY Name ASC, Selection: Single) {
      column (Attribute: PartID, Caption: 'Part ID')
      column (Attribute: Name, Caption: 'Name')
      column (Attribute: Description, Caption: 'Description')
      column (Attribute: Price, Caption: 'Price')
      column (Attribute: IsAdditionalPart, Caption: 'Additional part')
      column (Attribute: Vendor, Caption: 'Vendor')
      column (Attribute: Part_UnitOfMeasure/UnitName, Caption: 'Unit of measure')
      column (Attribute: IsActive, Caption: 'Is active')
      column (Caption: ' ') {
        actionbutton actionButton1 (Caption: 'Open', Action: SHOW PAGE Part.Part_View(Part = $currentObject))
        actionbutton actionButton2 (Caption: 'Delete', Action: CALL MICROFLOW Part.ACT_Part_Delete(Part = $currentObject))
      }
    }
  };
};
alter page Part.Part_View {
  replace grid1 with {
    datagrid grid1 (DataSource: DATABASE AssetManagement.Asset WHERE [Part.AssetPart_Asset/Part.AssetPart/Part.AssetPart_Part = $Part], Selection: Single) {
      column (Attribute: AssetID, Caption: 'Asset ID')
      column (Attribute: Description, Caption: 'Description')
      column (Attribute: Asset_Customer/CustomerName, Caption: 'Customer')
      column (Attribute: Asset_Manufacturer/Name, Caption: 'Manufacturer')
      column (Attribute: Address, Caption: 'Address')
      column (Attribute: City, Caption: 'City')
      column (Attribute: Asset_Technician_Preferred/TechnicianName, Caption: 'Preferred technician')
      column (Caption: ' ') {
        actionbutton actionButton2 (Caption: 'Open', Action: SHOW PAGE AssetManagement.Asset_View(Asset = $currentObject))
      }
    }
  };
};
alter snippet Part.Snippet_Part_Details {
  replace referenceSelector1 with {
    dataview dv_referenceSelector1 (DataSource: $Part) {
      combobox referenceSelector1 (Label: 'Unit of measurement *', Association: Part.Part_UnitOfMeasure, DataSource: database Part.UnitOfMeasure, CaptionAttribute: UnitName)
    }
  };
};
alter page Part.SuggestedPart_NewEdit {
  replace grid2 with {
    datagrid grid2 (DataSource: DATABASE Part.Part WHERE [IsActive], Selection: Single) {
      column (Attribute: PartID, Caption: 'Part ID')
      column (Attribute: Name, Caption: 'Name')
      column (Attribute: Description, Caption: 'Description')
      column (Attribute: Price, Caption: 'Price')
      column (Attribute: Vendor, Caption: 'Vendor')
      column (Caption: ' ') {
        actionbutton actionButton3 (Caption: 'Choose Part', Action: CALL MICROFLOW Part.ACT_Part_AssociateSuggestedPart(Part = $currentObject, SuggestedPart = $SuggestedPart))
      }
    }
  };
};
alter page Part.UnitOfMeasure_Overview {
  replace grid1 with {
    datagrid grid1 (DataSource: DATABASE Part.UnitOfMeasure, Selection: Single) {
      column (Attribute: UnitName, Caption: 'Unit name')
      column (Attribute: Abbreviation, Caption: 'Abbreviation')
      column (Caption: ' ') {
        actionbutton actionButton1 (Caption: 'Open', Action: CALL MICROFLOW Part.ACT_UnitOfMeasure_View(UnitOfMeasure = $currentObject))
        actionbutton actionButton3 (Caption: 'Delete', Action: CALL MICROFLOW Part.ACT_UnitOfMeasure_Delete(UnitOfMeasure = $currentObject))
      }
    }
  };
};
alter page Tool.SelectedTool_NewEdit {
  replace referenceSelector2 with {
    combobox referenceSelector2 (Label: 'Tool', Association: Tool.SelectedTool_Tool, DataSource: database Tool.Tool, CaptionAttribute: Name)
  };
};
alter page Tool.Tool_Overview {
  replace grid1 with {
    datagrid grid1 (DataSource: DATABASE Tool.Tool, Selection: Single) {
      column (Attribute: Name, Caption: 'Name')
      column (Attribute: Description, Caption: 'Description')
      column (Attribute: IsActive, Caption: 'Active')
      column (Attribute: createdDate, Caption: 'Created on')
      column (Attribute: changedDate, Caption: 'Last changed')
      column (Caption: ' ') {
        actionbutton actionButton1 (Caption: 'Open', Action: SHOW PAGE Tool.Tool_View(Tool = $currentObject))
        actionbutton actionButton2 (Caption: 'Delete', Action: CALL MICROFLOW Tool.ACT_Tool_Delete(Tool = $currentObject))
      }
    }
