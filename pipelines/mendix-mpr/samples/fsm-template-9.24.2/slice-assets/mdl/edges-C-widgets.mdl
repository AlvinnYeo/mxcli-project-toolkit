};
alter page WarehouseManagement.Inventory_NewEdit {
  replace referenceSelector2 with {
    combobox referenceSelector2 (Label: 'Part *', Association: WarehouseManagement.Inventory_Part, DataSource: database Part.Part, CaptionAttribute: Name)
  };
};
alter page WarehouseManagement.Inventory_View {
  replace referenceSelector3 with {
    combobox referenceSelector3 (Label: 'Part name', Association: WarehouseManagement.Inventory_Part, DataSource: database Part.Part, CaptionAttribute: Name)
  };
};
alter snippet WarehouseManagement.Snippet_Warehouse_DataTabs {
  replace grid1 with {
    datagrid grid1 (DataSource: DATABASE WarehouseManagement.Inventory WHERE [WarehouseManagement.Inventory_Warehouse = $Warehouse], Selection: Single) {
      column (Attribute: Inventory_Part/Name, Caption: 'Part name')
      column (Attribute: Amount, Caption: 'Amount')
      column (Attribute: Inventory_Part/Part_UnitOfMeasure/UnitName, Caption: 'Unit of measure')
      column (Attribute: Inventory_Part/Vendor, Caption: 'Vendor')
      column (Caption: ' ') {
        actionbutton actionButton2 (Caption: 'Details', Action: SHOW PAGE WarehouseManagement.Inventory_View(Inventory = $currentObject))
        actionbutton actionButton1 (Caption: 'Delete', Action: CALL MICROFLOW WarehouseManagement.ACT_Inventory_Delete(Inventory = $currentObject))
      }
      controlbar {
        actionbutton actionButton3 (Caption: 'New Inventory', Action: CALL MICROFLOW WarehouseManagement.ACT_Inventory_New(Warehouse = $Warehouse))
      }
    }
  };
  replace grid2 with {
    datagrid grid2 (DataSource: DATABASE Technician.Technician WHERE [Technician.Technician_Warehouse = $Warehouse][IsActive] SORT BY TechnicianID ASC, Selection: Single) {
      column (Attribute: TechnicianName, Caption: 'Name')
      column (Attribute: TelephoneNumber, Caption: 'Telephone number')
      column (Attribute: EmployeeNumber, Caption: 'Employee number')
      column (Attribute: CompanyName, Caption: 'Company name')
    }
  };
};
alter page WarehouseManagement.Warehouse_Overview {
  replace grid1 with {
    datagrid grid1 (DataSource: DATABASE WarehouseManagement.Warehouse SORT BY Description ASC, Selection: Single) {
      column (Attribute: WarehouseID, Caption: 'Warehouse ID')
      column (Attribute: Description, Caption: 'Description')
      column (Caption: ' ') {
        actionbutton actionButton1 (Caption: 'Open', Action: SHOW PAGE WarehouseManagement.Warehouse_View(Warehouse = $currentObject))
        actionbutton actionButton3 (Caption: 'Delete', Action: CALL MICROFLOW WarehouseManagement.ACT_Warehouse_Delete(Warehouse = $currentObject))
      }
    }
  };
};
