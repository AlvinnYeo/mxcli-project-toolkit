    menu item 'Registration codes' ( OnClick: show page TimeRegistration.RegistrationCode_Overview )
    menu item 'Skills' ( OnClick: call microflow Skill.NAV_Skill )
    menu item 'Business contacts' ( OnClick: show page CustomerManagement.ContactPerson_Overview )
