    menu item 'Technicians' ( OnClick: show page Technician.Technician_Overview )
    menu item 'Technician groups' ( OnClick: show page Technician.TechnicianGroup_Overview )
    menu item 'Offline actions' ( OnClick: show page Synchronization.OfflineAction_Overview )
    menu item 'Reasons' ( OnClick: show page Reason.Reason_Overview )
    menu item 'Priorities' ( OnClick: show page TicketManagement.Priority_Overview )
    menu item 'Scheduled Events' ( OnClick: show page Administration.ScheduledEvents )
    menu item 'Scripts' ( OnClick: show page AppSettings.Script_Overview )
    menu item 'SLA''s' ( OnClick: show page CustomerManagement.SLA_Overview )
    menu item 'Snap settings' ( OnClick: call microflow Scheduler.NAV_SnapSetting_Open )
    menu item 'Systemlogs' ( OnClick: show page ModuleIntegration_Logging_Impl.Message_Overview_2 )
