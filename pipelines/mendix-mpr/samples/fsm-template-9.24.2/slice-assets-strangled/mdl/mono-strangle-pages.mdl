  menu 'Administration' ( Icon: glyph 57369 ) {
    menu item 'Accounts' ( OnClick: show page ModuleIntegration_Administration_Impl.Account_Overview )
    menu item 'Application settings' ( OnClick: call microflow AppSettings.NAV_ApplicationSettings_Overview )
