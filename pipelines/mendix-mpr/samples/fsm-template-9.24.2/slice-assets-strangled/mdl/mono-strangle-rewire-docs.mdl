mdl 1;
-- Increment 7, monolith step 5: the referencing microflows, described after the move and edited (fix-cur.py, fix-cur2.py)
create or modify microflow Dashboard.ACT_AssetDashboardNP_ShowAsset (
  $AssetDashboardNP: Dashboard.AssetDashboardNP
)
folder 'Pages/Dashboards'
begin
  retrieve $Asset from $AssetDashboardNP/Dashboard.AssetDashboardNP_Asset;
  show message 'Asset details live in the Assets & Parts app.' type Information;
  return;
end;

grant execute on microflow Dashboard.ACT_AssetDashboardNP_ShowAsset to Dashboard.ViewAll;

create or modify microflow FSMPublishedAPI.Asset_MapToAssetResponse (
  $Asset: AssetsClient.Asset
)
returns FSMPublishedAPI.AssetResponse
folder 'Objects/Asset'
export level api
begin
  retrieve $Manufacturer from AssetsClient.Manufacturer
    where AssetsClient.Asset_Manufacturer = $Asset
    first;
  retrieve $Customer from CustomerManagement.Customer
    where PublicID = $Asset/CustomerPublicID
    first;
  $NewAssetResponse = create FSMPublishedAPI.AssetResponse (AssetID = $Asset/AssetID, Description = $Asset/Description, Notes = $Asset/Notes, Address = $Asset/Address, ZipCode = $Asset/ZipCode, City = $Asset/City, FullAddress = $Asset/FullAddress, HasOpeningTimes = $Asset/HasOpeningTimes, Manufacturer = $Manufacturer/Name, CustomerName = $Customer/CustomerName);
  return $NewAssetResponse;
end;

create or modify microflow FSMPublishedAPI.TicketRequest_ValidateSLA (
  $Asset: AssetsClient.Asset,
  $TicketRequest: FSMPublishedAPI.TicketRequest
)
returns List of FSMPublishedAPI.ErrorMessage
folder 'Objects/TicketRequest'
export level api
begin
  $SLA = call microflow AssetsClient.Asset_GetRelevantSLA(Asset = $Asset);
  @caption 'Has SLA?'
  if $SLA != empty then
    $ErrorMessageList = create list of FSMPublishedAPI.ErrorMessage;
    @merge(1065, 200)
    @caption 'Customer reference required?'
    if $SLA/NeedsMandatoryTaskNumber then
      @merge(1065, 200)
      @caption 'Customer reference?'
      if not(trim($TicketRequest/CustomerReference) != '') then
        @anchor(to: top)
        $NewErrorMessage = create FSMPublishedAPI.ErrorMessage (Message = 'customerReference is a required field');
        add $NewErrorMessage to $ErrorMessageList;
      end if;
    end if;
    return $ErrorMessageList;
  else
    @anchor(to: top)
    return empty;
  end if;
end;

create or modify microflow FSMPublishedAPI.TicketRequest_ValidateSchedulingOption (
  $TicketRequest: FSMPublishedAPI.TicketRequest,
  $Asset: AssetsClient.Asset
)
returns List of FSMPublishedAPI.ErrorMessage
folder 'Objects/TicketRequest'
export level api
begin
  -- WARNING: the merge at (1485, 185) is not represented in this description - it joins no decision and no error handler, so re-executing this MDL DELETES it. The microflow behaves the same either way (a merge with one incoming path is a no-op), but the node disappears from the diagram (mxcli #923)
  $ErrorMessageList = create list of FSMPublishedAPI.ErrorMessage;
  @merge(1485, 380)
  @caption 'Should schedule manually?'
  if $TicketRequest/ShouldScheduleManually then
    @merge(770, 185)
    @caption 'Technician?'
    if $TicketRequest/TechnicianID != empty then
    else
      @anchor(to: top)
      $NewErrorMessage_TechnicianID = create FSMPublishedAPI.ErrorMessage (Message = 'TechnicianID is a required field');
      @anchor(from: top)
      add $NewErrorMessage_TechnicianID to $ErrorMessageList;
    end if;
    @merge(1130, 185)
    @caption 'ExpectedStartTime?'
    if $TicketRequest/ExpectedArrivalDateTime != empty then
    else
      @anchor(to: top)
      $NewErrorMessage_ExpectedStartTime = create FSMPublishedAPI.ErrorMessage (Message = 'ExpectedStartTime is a required field');
      @anchor(from: top)
      add $NewErrorMessage_ExpectedStartTime to $ErrorMessageList;
    end if;
  @anchor(to: top)
  @caption 'Should Notify Directly?'
  elsif $TicketRequest/ShouldNotifyDirectly then
    @merge(770, 380)
    @caption 'Preferred Technician?'
    if $Asset/PreferredTechnicianID != empty then
    else
      @anchor(to: top)
      $NewErrorMessage_PreferredTechnician = create FSMPublishedAPI.ErrorMessage (Message = 'Asset does not contain a preferred technician');
      @anchor(from: top)
      add $NewErrorMessage_PreferredTechnician to $ErrorMessageList;
    end if;
    $Technician = call microflow TicketManagement.WorkOrder_TechnicianPicker(Asset = $Asset, WorkOrder_optional = empty);
    @merge(1335, 380)
    @caption 'Any?'
    if $Technician != empty then
    else
      @anchor(to: top)
      $NewErrorMessage_PreferredTechnician_Availability = create FSMPublishedAPI.ErrorMessage (Message = 'Preferred technician is not available');
      @anchor(from: top)
      add $NewErrorMessage_PreferredTechnician_Availability to $ErrorMessageList;
    end if;
  else
    @anchor(to: top)
    return $ErrorMessageList;
  end if;
  join shared1;
  merge shared1;
  return $ErrorMessageList;
end;

create or modify microflow General.ASU_General ()
returns Boolean
folder 'Resources'
export level api
begin
  @annotation(text: 'Logging module', position: (-3620, 115), size: (110, 40))
  call microflow Logging.AfterStartup();
  call microflow AppSettings.ASU_AppSettings();
  call microflow AppSettings.ASU_FeatureToggle();
  call microflow General.ASU_Snapshot_Shift();
  call microflow General.ASU_RegistrationCode_CreateDefaultIfNonExists();
  call microflow Reason.ASU_CreateStandardReason();
  call microflow General.ASU_DemoUserList_CreateIfNeeded();
  $Variable = call microflow MendixSSO.MendixSSO_AfterStartup();
  -- TEST-ONLY (journey accounts + the slice machine account); remove before real use
  call microflow AssetsSeam.ASU_EnsureJourneyAccounts();
  return true;
end;

create or modify microflow NativeMobileAsset.Asset_RetrieveAppointmentList_ByStatus (
  $Asset: AssetsClient.Asset,
  $Search: String,
  $Page: Integer,
  $RelatedWorkHelperDownload: NativeMobileRelated.RelatedWorkHelperDownload,
  $ENUM_AppointmentStatus: enum TicketManagement.ENUM_AppointmentStatus
)
returns List of TicketManagement.Appointment
folder 'Objects/Asset'
begin
  @annotation(text: 'This microflow should be used to return the search result when searching for appointments related to an asset on the Native device.', position: (-190, -110), size: (330, 100))
  declare $SearchString String = trim($Search);
  declare $Amount Integer = $Page * 10;
  retrieve $AppointmentList_Total from TicketManagement.Appointment
    where [Status = $ENUM_AppointmentStatus]
    [TicketManagement.Appointment_WorkOrder/TicketManagement.WorkOrder[TicketManagement.WorkOrder_Ticket/TicketManagement.Ticket/TicketManagement.Ticket_Asset = $Asset][$SearchString = '' or contains(Description, $SearchString) or contains(ShortDescription, $SearchString) or contains(WorkOrderID, $SearchString) or TicketManagement.WorkOrder_Ticket/TicketManagement.Ticket[contains(Description, $SearchString) or contains(ShortDescription, $SearchString) or contains(TicketID, $SearchString)]]];
  $Count = count $AppointmentList_Total;
  retrieve $AppointmentList_All from TicketManagement.Appointment
    where [Status = $ENUM_AppointmentStatus]
    [TicketManagement.Appointment_WorkOrder/TicketManagement.WorkOrder[TicketManagement.WorkOrder_Ticket/TicketManagement.Ticket/TicketManagement.Ticket_Asset = $Asset][$SearchString = '' or contains(Description, $SearchString) or contains(ShortDescription, $SearchString) or contains(WorkOrderID, $SearchString) or TicketManagement.WorkOrder_Ticket/TicketManagement.Ticket[contains(Description, $SearchString) or contains(ShortDescription, $SearchString) or contains(TicketID, $SearchString)]]]
    limit $Amount;
  change $RelatedWorkHelperDownload (HasResults = $AppointmentList_All != empty, HasMoreData = $Amount < $Count);
  return $AppointmentList_All;
end;

create or modify microflow NativeMobileAsset.Asset_RetrieveUnplannedWorkOrderList (
  $Asset: AssetsClient.Asset,
  $Search: String,
  $Page: Integer,
  $RelatedWorkHelperDownload: NativeMobileRelated.RelatedWorkHelperDownload
)
returns List of TicketManagement.WorkOrder
folder 'Objects/Asset'
begin
  @annotation(text: 'This microflow should be used to return the search result when searching for workorders related to an asset on the Native device.', position: (-315, -145), size: (330, 100))
  declare $SearchString String = trim($Search);
  declare $Amount Integer = $Page * 10;
  retrieve $WorkOrderList_Total from TicketManagement.WorkOrder
    where [TicketManagement.WorkOrder_Ticket/TicketManagement.Ticket/TicketManagement.Ticket_Asset = $Asset]
    [Status = TicketManagement.ENUM_WorkOrderStatus.Partially_planned or Status = TicketManagement.ENUM_WorkOrderStatus._New]
    [$SearchString = '' or contains(Description, $SearchString) or contains(ShortDescription, $SearchString) or contains(WorkOrderID, $SearchString) or TicketManagement.WorkOrder_Ticket/TicketManagement.Ticket[contains(Description, $SearchString) or contains(ShortDescription, $SearchString) or contains(TicketID, $SearchString)]];
  $Count = count $WorkOrderList_Total;
  retrieve $WorkOrderList_All from TicketManagement.WorkOrder
    where [TicketManagement.WorkOrder_Ticket/TicketManagement.Ticket/TicketManagement.Ticket_Asset = $Asset]
    [Status = TicketManagement.ENUM_WorkOrderStatus.Partially_planned or Status = TicketManagement.ENUM_WorkOrderStatus._New]
    [$SearchString = '' or contains(Description, $SearchString) or contains(ShortDescription, $SearchString) or contains(WorkOrderID, $SearchString) or TicketManagement.WorkOrder_Ticket/TicketManagement.Ticket[contains(Description, $SearchString) or contains(ShortDescription, $SearchString) or contains(TicketID, $SearchString)]]
    sort by DueDate asc, WorkOrderID asc
    limit $Amount;
  change $RelatedWorkHelperDownload (HasResults = $WorkOrderList_All != empty, HasMoreData = $Amount < $Count);
  return $WorkOrderList_All;
end;

create or modify microflow NativeMobilePart.PartNP_ValidateUniqueName (
  $Name: String
)
returns Boolean
folder 'Objects/PartNP'
begin
  $NameIsUsed = call microflow AssetsClient.Part_NameIsInUse(Name = $Name);
  return $NameIsUsed = false;
end;

grant execute on microflow NativeMobilePart.PartNP_ValidateUniqueName to NativeMobilePart.EditMy;

create or modify microflow NativeMobilePart.PartSearchHelper_SearchInventories (
  $PartSearchHelper: NativeMobilePart.PartSearchHelper
)
folder 'Objects/PartSearchHelper'
export level api
begin
  retrieve $NativeInventoryNPList from $PartSearchHelper/NativeMobileWarehouse.InventoryNP_PartSearchHelper;
  delete $NativeInventoryNPList;
  declare $SearchString String = trim($PartSearchHelper/Search);
  declare $Amount Integer = $PartSearchHelper/NumberOfPages * 10;
  declare $PartSystemID String = $PartSearchHelper/NativeMobilePart.PartSearchHelper_PartNP_Chosen/NativeMobilePart.PartNP/SystemID;
  retrieve $InventoryList_Total from AssetsClient.Inventory
    where [AssetsClient.Inventory_Part/AssetsClient.Part/SystemID = $PartSystemID]
    [AssetsClient.Inventory_Warehouse/AssetsClient.Warehouse/Technician.Technician_Warehouse/Technician.Technician/Administration.Account_Technician = '[%CurrentUser%]']
    [$SearchString = '' or contains(AssetsClient.Inventory_Warehouse/AssetsClient.Warehouse/Description, $SearchString)]
    sort by InventoryID asc
    limit $Amount;
  retrieve $InventoryList_Next from AssetsClient.Inventory
    where [AssetsClient.Inventory_Part/AssetsClient.Part/SystemID = $PartSystemID]
    [AssetsClient.Inventory_Warehouse/AssetsClient.Warehouse/Technician.Technician_Warehouse/Technician.Technician/Administration.Account_Technician = '[%CurrentUser%]']
    [$SearchString = '' or contains(AssetsClient.Inventory_Warehouse/AssetsClient.Warehouse/Description, $SearchString)]
    sort by InventoryID asc
    limit $Amount + 1
    offset $Amount;
  change $PartSearchHelper (IsInventoryFound = $InventoryList_Total != empty, HasMoreData = $InventoryList_Next != empty) refresh;
  loop $IteratorInventory in $InventoryList_Total
  begin
    $NewNativeInventoryNP = create NativeMobileWarehouse.InventoryNP (SystemID = $IteratorInventory/SystemID, Amount = $IteratorInventory/Amount, WarehouseDescription = $IteratorInventory/AssetsClient.Inventory_Warehouse/AssetsClient.Warehouse/Description, InventoryNP_PartSearchHelper = $PartSearchHelper);
  end loop;
  return;
end;

grant execute on microflow NativeMobilePart.PartSearchHelper_SearchInventories to NativeMobilePart.EditMy;

create or modify microflow NativeMobilePart.PartSearchHelper_SearchParts (
  $PartSearchHelper: NativeMobilePart.PartSearchHelper
)
folder 'Objects/PartSearchHelper'
export level api
begin
  retrieve $NativePartNPList from $PartSearchHelper/NativeMobilePart.PartNP_PartSearchHelper;
  delete $NativePartNPList;
  declare $SearchString String = trim($PartSearchHelper/Search);
  declare $Amount Integer = $PartSearchHelper/NumberOfPages * 10;
  $PartList = create list of AssetsClient.Part;
  @merge(1525, 255)
  @caption 'SearchoutsideBOM'
  if $PartSearchHelper/SearchOutsideBOM then
    retrieve $PartList_Total from AssetsClient.Part
    where [AssetsClient.Inventory_Part/AssetsClient.Inventory/AssetsClient.Inventory_Warehouse/AssetsClient.Warehouse/Technician.Technician_Warehouse/Technician.Technician/Administration.Account_Technician = '[%CurrentUser%]']
    [$SearchString = '' or contains(PartID, $SearchString) or contains(Name, $SearchString) or contains(Description, $SearchString) or contains(Vendor, $SearchString)]
    sort by Name asc
    limit $Amount;
    retrieve $PartList_Next from AssetsClient.Part
    where [AssetsClient.Inventory_Part/AssetsClient.Inventory/AssetsClient.Inventory_Warehouse/AssetsClient.Warehouse/Technician.Technician_Warehouse/Technician.Technician/Administration.Account_Technician = '[%CurrentUser%]']
    [$SearchString = '' or contains(PartID, $SearchString) or contains(Name, $SearchString) or contains(Description, $SearchString) or contains(Vendor, $SearchString)]
    sort by Name asc
    limit $Amount + 1
    offset $Amount;
    change $PartSearchHelper (IsPartFound = $PartList_Total != empty, HasMoreData = $PartList_Next != empty) refresh;
    add $PartList_Total to $PartList;
  else
    $Appointment = call microflow TicketManagement.Appointment_Get_BySystemID(SystemID = $PartSearchHelper/AppointmentID);
    retrieve $PartList_Total_BOM from AssetsClient.Part
    where [AssetsClient.Inventory_Part/AssetsClient.Inventory/ AssetsClient.Inventory_Warehouse/AssetsClient.Warehouse/ Technician.Technician_Warehouse/Technician.Technician/Administration.Account_Technician = '[%CurrentUser%]']
    [AssetsClient.AssetPart_Part/AssetsClient.AssetPart/ AssetsClient.AssetPart_Asset/AssetsClient.Asset/ TicketManagement.Ticket_Asset/TicketManagement.Ticket/ TicketManagement.WorkOrder_Ticket/TicketManagement.WorkOrder/ TicketManagement.Appointment_WorkOrder = $Appointment]
    [$SearchString = '' or contains(PartID, $SearchString) or contains(Name, $SearchString) or contains(Description, $SearchString) or contains(Vendor, $SearchString)]
    sort by Name asc
    limit $Amount;
    retrieve $PartList_Next_BOM from AssetsClient.Part
    where [AssetsClient.Inventory_Part/AssetsClient.Inventory/ AssetsClient.Inventory_Warehouse/AssetsClient.Warehouse/ Technician.Technician_Warehouse/Technician.Technician/Administration.Account_Technician = '[%CurrentUser%]']
    [AssetsClient.AssetPart_Part/AssetsClient.AssetPart/ AssetsClient.AssetPart_Asset/AssetsClient.Asset/ TicketManagement.Ticket_Asset/TicketManagement.Ticket/ TicketManagement.WorkOrder_Ticket/TicketManagement.WorkOrder/ TicketManagement.Appointment_WorkOrder = $Appointment]
    [$SearchString = '' or contains(PartID, $SearchString) or contains(Name, $SearchString) or contains(Description, $SearchString) or contains(Vendor, $SearchString)]
    sort by Name asc
    limit $Amount + 1
    offset $Amount;
    change $PartSearchHelper (IsPartFound = $PartList_Total_BOM != empty, HasMoreData = $PartList_Next_BOM != empty) refresh;
    add $PartList_Total_BOM to $PartList;
  end if;
  loop $IteratorPart in $PartList
  begin
    $NewAssetSearchResult = create NativeMobilePart.PartNP (PartID = $IteratorPart/PartID, SystemID = $IteratorPart/SystemID, Description = $IteratorPart/Description, Name = $IteratorPart/Name, Vendor = $IteratorPart/Vendor, Price = $IteratorPart/Price, PartNP_PartSearchHelper = $PartSearchHelper, UnitName = $IteratorPart/AssetsClient.Part_UnitOfMeasure/AssetsClient.UnitOfMeasure/UnitName, Abbreviation = $IteratorPart/AssetsClient.Part_UnitOfMeasure/AssetsClient.UnitOfMeasure/Abbreviation);
  end loop;
  return;
end;

grant execute on microflow NativeMobilePart.PartSearchHelper_SearchParts to NativeMobilePart.EditMy;

create or modify microflow NativeMobileRelated.Asset_PopulateRelatedWorkHelper (
  $AssetSystemID: String,
  $SearchFinished: String,
  $PageFinished: Integer,
  $SearchPlanned: String,
  $PagePlanned: Integer,
  $SearchUnplanned: String,
  $PageUnplanned: Integer
)
returns NativeMobileRelated.RelatedWorkAssetHelper
folder 'Objects/Asset'
export level api
begin
  $Asset = call microflow AssetsClient.Asset_Get_BySystemID(SystemID = $AssetSystemID);
  @caption 'Asset?'
  if $Asset != empty then
    $RelatedWorkAssetHelper = call microflow NativeMobileRelated.RelatedWorkAssetHelper_Create();
    $RelatedWorkHelperDownload_Finished = create NativeMobileRelated.RelatedWorkHelperDownload (RelatedWorkAssetHelper_RelatedWorkHelperDownload_Finished = $RelatedWorkAssetHelper);
    $AppointmentList_Finished = call microflow NativeMobileAsset.Asset_RetrieveAppointmentList_ByStatus(Asset = $Asset, Search = $SearchFinished, Page = $PageFinished, RelatedWorkHelperDownload = $RelatedWorkHelperDownload_Finished, ENUM_AppointmentStatus = TicketManagement.ENUM_AppointmentStatus.Finished);
    $NativeAppointmentNPList_Finished = call microflow NativeMobileRelated.NativeAppointmentNP_CreateList(AppointmentList = $AppointmentList_Finished);
    loop $IteratorNativeAppointmentNP_Finished in $NativeAppointmentNPList_Finished
    begin
      change $IteratorNativeAppointmentNP_Finished (NativeMobile.NativeAppointmentNP_RelatedWorkHelper = $RelatedWorkHelperDownload_Finished);
    end loop;
    $RelatedWorkHelperDownload_Planned = create NativeMobileRelated.RelatedWorkHelperDownload (RelatedWorkAssetHelper_RelatedWorkHelperDownload_Planned = $RelatedWorkAssetHelper);
    $AppointmentList_Planned = call microflow NativeMobileAsset.Asset_RetrieveAppointmentList_ByStatus(Asset = $Asset, Search = $SearchPlanned, Page = $PagePlanned, RelatedWorkHelperDownload = $RelatedWorkHelperDownload_Planned, ENUM_AppointmentStatus = TicketManagement.ENUM_AppointmentStatus.Planned);
    $NativeAppointmentNPList_Unplanned = call microflow NativeMobileRelated.NativeAppointmentNP_CreateList(AppointmentList = $AppointmentList_Planned);
    loop $IteratorNativeAppointmentNP_Planned in $NativeAppointmentNPList_Unplanned
    begin
      change $IteratorNativeAppointmentNP_Planned (NativeMobile.NativeAppointmentNP_RelatedWorkHelper = $RelatedWorkHelperDownload_Planned);
    end loop;
    $RelatedWorkHelperDownload_Unplanned = create NativeMobileRelated.RelatedWorkHelperDownload (RelatedWorkAssetHelper_RelatedWorkHelperDownload_Unplanned = $RelatedWorkAssetHelper);
    $WorkOrderList_Unplanned = call microflow NativeMobileAsset.Asset_RetrieveUnplannedWorkOrderList(Asset = $Asset, Search = $SearchUnplanned, Page = $PageUnplanned, RelatedWorkHelperDownload = $RelatedWorkHelperDownload_Unplanned);
    $NativeWorkOrderNPList = call microflow NativeMobileRelated.NativeWorkOrderNP_CreateList(WorkOrderList = $WorkOrderList_Unplanned);
    loop $IteratorNativeWorkOrderNP in $NativeWorkOrderNPList
    begin
      change $IteratorNativeWorkOrderNP (NativeMobile.NativeWorkOrderNP_RelatedWorkHelper = $RelatedWorkHelperDownload_Unplanned);
    end loop;
    return $RelatedWorkAssetHelper;
  else
    @anchor(to: top)
    return empty;
  end if;
end;

grant execute on microflow NativeMobileRelated.Asset_PopulateRelatedWorkHelper to NativeMobileRelated.ViewRelated;

create or modify microflow NativeMobileRelated.NativeWorkOrderNPSearchHelperDownload_GetRelevantWorkorderList (
  $NativeWorkOrderNPSearchHelperDownload: NativeMobileRelated.NativeWorkOrderNPSearchHelperDownload,
  $Search: String,
  $Page: Integer
)
returns List of TicketManagement.WorkOrder
folder 'Objects/NativeWorkOrderNPSearchHelperDownload'
begin
  @annotation(text: 'This microflow should be used to return the search result when searching for unplanned workorders on the Native device.', position: (-1355, -40), size: (330, 100))
  $Technician_Current = call microflow Technician.Technician_Get_ForCurrentUser();
  declare $SearchString String = trim($Search);
  declare $Amount Integer = $Page * 10;
  retrieve $WorkOrderList_Total from TicketManagement.WorkOrder
    where [Status = TicketManagement.ENUM_WorkOrderStatus.Partially_planned or Status = TicketManagement.ENUM_WorkOrderStatus._New]
    [(AssignedStatus = TicketManagement.ENUM_AssignedStatus.Unassigned and not(TicketManagement.WorkOrderAssignment_WorkOrder/TicketManagement.WorkOrderAssignment/Status = 'Pending')) or (TicketManagement.WorkOrderAssignment_WorkOrder/TicketManagement.WorkOrderAssignment[Status = 'Accepted' or Status = 'Auto_accepted' or Status = 'Pending']/TicketManagement.WorkOrderAssignment_Technician = $Technician_Current) or (TicketManagement.WorkOrder_TechnicianGroup/Technician.TechnicianGroup/Technician.TechnicianGroup_Technician = $Technician_Current)]
    [TicketManagement.WorkOrder_Skill/Skill.Skill/Technician.Technician_Skill = $Technician_Current or not(TicketManagement.WorkOrder_Skill/Skill.Skill)]
    [$SearchString = '' or contains(Description, $SearchString) or contains(ShortDescription, $SearchString) or contains(WorkOrderID, $SearchString) or TicketManagement.WorkOrder_Ticket/TicketManagement.Ticket[contains(Description, $SearchString) or contains(ShortDescription, $SearchString) or contains(TicketID, $SearchString)]];
  $WorkOrderList_RightSkills = call microflow Skill.Technician_CheckWorkOrderListOnSkills(WorkOrderList = $WorkOrderList_Total, Technician = $Technician_Current);
  $Count = count $WorkOrderList_RightSkills;
  retrieve $WorkOrderList_All from TicketManagement.WorkOrder
    where [Status = TicketManagement.ENUM_WorkOrderStatus.Partially_planned or Status = TicketManagement.ENUM_WorkOrderStatus._New]
    [(AssignedStatus = TicketManagement.ENUM_AssignedStatus.Unassigned and not(TicketManagement.WorkOrderAssignment_WorkOrder/TicketManagement.WorkOrderAssignment/Status = 'Pending')) or (TicketManagement.WorkOrderAssignment_WorkOrder/TicketManagement.WorkOrderAssignment[Status = 'Accepted' or Status = 'Auto_accepted' or Status = 'Pending']/TicketManagement.WorkOrderAssignment_Technician = $Technician_Current) or (TicketManagement.WorkOrder_TechnicianGroup/Technician.TechnicianGroup/Technician.TechnicianGroup_Technician = $Technician_Current)]
    [TicketManagement.WorkOrder_Skill/Skill.Skill/Technician.Technician_Skill = $Technician_Current or not(TicketManagement.WorkOrder_Skill/Skill.Skill)]
    [$SearchString = '' or contains(Description, $SearchString) or contains(ShortDescription, $SearchString) or contains(WorkOrderID, $SearchString) or TicketManagement.WorkOrder_Ticket/TicketManagement.Ticket[contains(Description, $SearchString) or contains(ShortDescription, $SearchString) or contains(TicketID, $SearchString)]]
    sort by DueDate asc, WorkOrderID asc
    limit $Amount;
  $WorkOrderList_ToReturn = call microflow Skill.Technician_CheckWorkOrderListOnSkills(WorkOrderList = $WorkOrderList_All, Technician = $Technician_Current);
  change $NativeWorkOrderNPSearchHelperDownload (IsWorkOrderFound = $WorkOrderList_All != empty, HasMoreData = $Amount < $Count, UnplannedWorkOrderCount = $Count);
  return $WorkOrderList_ToReturn;
end;

create or modify microflow NativeMobileRelated.NativeWorkOrderNP_Create (
  $WorkOrder: TicketManagement.WorkOrder
)
returns NativeMobile.NativeWorkOrderNP
folder 'Objects/NativeWorkOrderNP'
begin
  retrieve $Ticket from $WorkOrder/TicketManagement.WorkOrder_Ticket;
  retrieve $Asset from $Ticket/TicketManagement.Ticket_Asset;
  $AssigneesNameString = call microflow TicketManagement.WorkOrder_Get_AssigneeNameString(WorkOrder = $WorkOrder);
  $NewNativeWorkOrderNP = create NativeMobile.NativeWorkOrderNP (WorkOrderID = $WorkOrder/WorkOrderID, SystemID = $WorkOrder/SystemID, ShortDescription = $WorkOrder/ShortDescription, Description = $WorkOrder/Description, DueDate = $WorkOrder/DueDate, TicketID = $Ticket/TicketID, TicketDescription = $Ticket/Description, TicketTypeDescription = $Ticket/TicketManagement.Ticket_TicketType/TicketManagement.TicketType/Name, TicketPriorityLevel = $Ticket/TicketManagement.Ticket_Priority/TicketManagement.Priority/PriorityLevel, TicketPriorityDescription = $Ticket/TicketManagement.Ticket_Priority/TicketManagement.Priority/Description, TicketCallerName = $Ticket/CallerName, TicketCallerPhoneNumber = $Ticket/CallerPhoneNumber, TicketShortDescription = $Ticket/ShortDescription, AssetID = $Asset/AssetID, AssetFullAddress = $Asset/FullAddress, AssetCustomerName = $Asset/CustomerName, AssetDescription = $Asset/Description, AssetManufacturer = $Asset/AssetsClient.Asset_Manufacturer/AssetsClient.Manufacturer/Name, AssetNotes = $Asset/Notes, TicketDueDate = $Ticket/DueDate, TicketCreatedDate = $Ticket/CreationTime, AssignedStatus = $WorkOrder/AssignedStatus, WorkOrderStatus = $WorkOrder/Status, AssignedTechnicianName = $AssigneesNameString);
  return $NewNativeWorkOrderNP;
end;

create or modify microflow Scheduler.PlannerContext_GetWorkOrders (
  $PlannerContext: Scheduler.PlannerContext,
  $PageContext: Scheduler.PageContext
)
returns List of TicketManagement.WorkOrder
folder 'Objects/PlannerContext'
begin
  declare $Amount Integer = $PageContext/Page * 20;
  declare $SearchString String = trim($PageContext/SearchString);
  declare $TicketID_FilterQuery String = trim($PageContext/FilterTicketID);
  declare $WorkOrderID_FilterQuery String = trim($PageContext/FilterWorkOrderID);
  declare $AssetID_FilterQuery String = trim($PageContext/FilterAssetID);
  declare $Technician_FilterQuery String = trim($PageContext/FilterTechnician);
  declare $Location_FilterQuery String = trim($PageContext/FilterAddress);
  @merge(-1165, 85)
  @caption 'User is SDE?'
  if not(ModuleIntegration_Administration_Impl.Rule_User_HasUserRole_SDE(User = $currentUser/System.owner/Administration.Account)) then
    @anchor(to: top)
    @caption 'User is SRM?'
    if ModuleIntegration_Administration_Impl.Rule_User_HasUserRole_SRM(User = $currentUser/System.owner/Administration.Account) then
      @anchor(false: (from: top, to: bottom))
      @caption 'Show all?'
      if $PlannerContext/Scheduler.PlannerContext_TechnicianGroup = empty then
        retrieve $NextWorkOrder_SRM_1 from TicketManagement.WorkOrder
    where [$PageContext/Filter = empty or $PageContext/Filter = 'All' and (Status = TicketManagement.ENUM_WorkOrderStatus._New or Status = TicketManagement.ENUM_WorkOrderStatus.Partially_planned) or ($PageContext/Filter = '_New' and Status = TicketManagement.ENUM_WorkOrderStatus._New) or ($PageContext/Filter = 'PartiallyPlanned' and Status = TicketManagement.ENUM_WorkOrderStatus.Partially_planned)]
