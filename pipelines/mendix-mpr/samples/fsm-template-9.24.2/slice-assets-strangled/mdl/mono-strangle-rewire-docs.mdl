    [$PlannerContext/Scheduler.PlannerContext_TechnicianGroup = empty or TicketManagement.WorkOrderAssignment_WorkOrder/TicketManagement.WorkOrderAssignment[Status = 'Accepted' or Status = 'Auto_accepted']/TicketManagement.WorkOrderAssignment_Technician/Technician.Technician/Technician.TechnicianGroup_Technician = $PlannerContext/Scheduler.PlannerContext_TechnicianGroup or TicketManagement.WorkOrder_TechnicianGroup = $PlannerContext/Scheduler.PlannerContext_TechnicianGroup]
    sort by WorkOrderID asc
    limit $Amount;
      return $WorkOrderList_5;
    when Workorder_ID___Descending then
      retrieve $WorkOrderList_6 from TicketManagement.WorkOrder
    where [$PageContext/Filter = empty or $PageContext/Filter = 'All' and (Status = TicketManagement.ENUM_WorkOrderStatus._New or Status = TicketManagement.ENUM_WorkOrderStatus.Partially_planned) or ($PageContext/Filter = '_New' and Status = TicketManagement.ENUM_WorkOrderStatus._New) or ($PageContext/Filter = 'PartiallyPlanned' and Status = TicketManagement.ENUM_WorkOrderStatus.Partially_planned)]
    [$SearchString = '' or contains(ShortDescription, $SearchString) or contains(Description, $SearchString) or contains(WorkOrderID, $SearchString) or contains(TicketManagement._WorkOrder_Technician/Technician.Technician/TechnicianName, $SearchString) or TicketManagement.WorkOrder_Ticket/TicketManagement.Ticket[contains(TicketID, $SearchString) or contains(ShortDescription, $SearchString) or contains(Description, $SearchString) or TicketManagement.Ticket_Asset/AssetsClient.Asset[contains(AssetID, $SearchString) or contains(Description, $SearchString) or contains(FullAddress, $SearchString)]]]
    [$TicketID_FilterQuery = '' or contains(TicketManagement.WorkOrder_Ticket/TicketManagement.Ticket/TicketID, $TicketID_FilterQuery)]
    [$WorkOrderID_FilterQuery = '' or contains(WorkOrderID, $WorkOrderID_FilterQuery)]
    [$AssetID_FilterQuery = '' or contains(TicketManagement.WorkOrder_Ticket/TicketManagement.Ticket/TicketManagement.Ticket_Asset/AssetsClient.Asset/AssetID, $AssetID_FilterQuery)]
    [$Technician_FilterQuery = '' or contains(TicketManagement._WorkOrder_Technician/Technician.Technician/TechnicianName, $Technician_FilterQuery)]
    [$Location_FilterQuery = '' or contains(TicketManagement.WorkOrder_Ticket/TicketManagement.Ticket/TicketManagement.Ticket_Asset/AssetsClient.Asset/FullAddress, $Location_FilterQuery)]
    [$PlannerContext/Scheduler.PlannerContext_TechnicianGroup = empty or TicketManagement.WorkOrderAssignment_WorkOrder/TicketManagement.WorkOrderAssignment[Status = 'Accepted' or Status = 'Auto_accepted']/TicketManagement.WorkOrderAssignment_Technician/Technician.Technician/Technician.TechnicianGroup_Technician = $PlannerContext/Scheduler.PlannerContext_TechnicianGroup or TicketManagement.WorkOrder_TechnicianGroup = $PlannerContext/Scheduler.PlannerContext_TechnicianGroup]
    sort by WorkOrderID desc
    limit $Amount;
      return $WorkOrderList_6;
  end case;
end;

create or modify microflow Synchronization.Asset_ProcessUpdateNativeAsset (
  $Asset: AssetsClient.Asset,
  $NativeAssetList_ToCommit: List of NativeMobileAsset.NativeAsset
)
folder 'Objects/Asset/Private'
begin
  $NativeAsset = call microflow NativeMobileAsset.NativeAsset_GetOrCreate(SystemID = $Asset/SystemID, NativeAssetList_optional = $NativeAssetList_ToCommit);
  retrieve $Manufacturer from $Asset/AssetsClient.Asset_Manufacturer;
  change $NativeAsset (AssetID = $Asset/AssetID, Description = $Asset/Description, Notes = $Asset/Notes, FullAddress = $Asset/FullAddress, CustomerName = $Asset/CustomerName, Manufacturer = $Manufacturer/Name);
  add $NativeAsset to $NativeAssetList_ToCommit;
  return;
end;

create or modify microflow Synchronization.OfflineInventoryAction_Validate (
  $OfflineInventoryAction: Synchronization.OfflineInventoryAction
)
returns Boolean
folder 'Objects/OfflineInventoryAction/Private'
begin
  @annotation(text: 'Daan v. Otterloo 28/06/2022: Not posible to edit inventories etc only to create so no need for the usual validation here.', position: (-210, -5), size: (230, 50))
  -- WARNING: the merge at (-195, 490) is not represented in this description - it joins no decision and no error handler, so re-executing this MDL DELETES it. The microflow behaves the same either way (a merge with one incoming path is a no-op), but the node disappears from the diagram (mxcli #923)
  -- WARNING: the merge at (760, 490) is not represented in this description - it joins no decision and no error handler, so re-executing this MDL DELETES it. The microflow behaves the same either way (a merge with one incoming path is a no-op), but the node disappears from the diagram (mxcli #923)
  declare $IsValid Boolean = true;
  @merge(760, 180)
  @caption 'ActionType?'
  if $OfflineInventoryAction/InventoryActionType != empty then
    @merge(135, 180)
    @caption 'Amount?'
    if $OfflineInventoryAction/Amount != empty then
    else
      @anchor(from: bottom, to: top)
      set $IsValid = false;
      @anchor(to: top)
      call microflow Synchronization.OfflineAction_AppendReviewMessage(OfflineAction = $OfflineInventoryAction, Message = 'This offline action does not have the necessary Amount thus could not be processed. This is a system error. Please contact the system administrator.');
    end if;
    $Part = call microflow AssetsClient.Part_Get_BySystemID(SystemID = $OfflineInventoryAction/PartSystemID);
    @merge(760, 180)
    @caption 'Part?'
    if not($Part != empty) then
      @anchor(from: bottom, to: top)
      set $IsValid = false;
      @anchor(to: top)
      call microflow Synchronization.OfflineAction_AppendReviewMessage(OfflineAction = $OfflineInventoryAction, Message = 'The related Part is not available on web, this is a system error, contact your system administrator.');
    end if;
  else
    @anchor(from: bottom, to: top)
    set $IsValid = false;
    @anchor(from: bottom, to: top)
    call microflow Synchronization.OfflineAction_AppendReviewMessage(OfflineAction = $OfflineInventoryAction, Message = 'The type of this offline action could not be identified. 
This is a system error. Please contact the system administrator.');
  end if;
  return $IsValid;
end;

create or modify microflow Synchronization.OfflineTicketAction_Process (
  $OfflineTicketAction: Synchronization.OfflineTicketAction
)
returns Boolean
folder 'Objects/OfflineTicketAction/Private'
begin
  declare $SuccessfullyProcessed Boolean = false;
  $Ticket = call microflow TicketManagement.Ticket_GetCreate(SystemID = $OfflineTicketAction/ObjectID);
  @caption 'ticket action type'
  case $OfflineTicketAction/TicketActionType
    when Ticket_created then
      $TicketNP = call microflow TicketManagement.Ticket_CreateTicketNP(Ticket = $Ticket);
      $Technician = call microflow Technician.Technician_Get_ForCurrentUser();
      $Asset_NewTicket = call microflow AssetsClient.Asset_Get_BySystemID(SystemID = $OfflineTicketAction/AssetSystemID);
      change $TicketNP (ShortDescription = $OfflineTicketAction/ShortDescription, Description = $OfflineTicketAction/Description, CallerName = $Technician/TechnicianName, CallerPhoneNumber = $Technician/TelephoneNumber, TicketManagement.TicketNP_Asset = $Asset_NewTicket);
      $Ticket = call microflow TicketManagement.TicketNP_Malfunction_Save(TicketNP = $TicketNP);
    when Asset_confirmed then
      change $Ticket (AssetConfirmed = $OfflineTicketAction/CreatedDateTime);
      call microflow TicketManagement.Ticket_Save(Ticket = $Ticket);
    when Asset_changed then
      $Asset = call microflow AssetsClient.Asset_Get_BySystemID(SystemID = $OfflineTicketAction/AssetSystemID);
      change $Ticket (TicketManagement.Ticket_Asset = $Asset, AssetConfirmed = $OfflineTicketAction/CreatedDateTime);
      call microflow TicketManagement.Ticket_Save(Ticket = $Ticket);
    when (empty) then
      @anchor(to: top)
      return $SuccessfullyProcessed;
  end case;
  join shared1;
  merge shared1;
  set $SuccessfullyProcessed = true;
  return $SuccessfullyProcessed;
end;

create or modify microflow Synchronization.OfflineTicketAction_Validate (
  $OfflineTicketAction: Synchronization.OfflineTicketAction,
  $LastDownload: DateTime
)
returns Boolean
folder 'Objects/OfflineTicketAction/Private'
begin
  -- WARNING: the merge at (1550, 635) is not represented in this description - it joins no decision and no error handler, so re-executing this MDL DELETES it. The microflow behaves the same either way (a merge with one incoming path is a no-op), but the node disappears from the diagram (mxcli #923)
  -- WARNING: the merge at (-30, 635) is not represented in this description - it joins no decision and no error handler, so re-executing this MDL DELETES it. The microflow behaves the same either way (a merge with one incoming path is a no-op), but the node disappears from the diagram (mxcli #923)
  -- WARNING: the merge at (475, -140) is not represented in this description - it joins no decision and no error handler, so re-executing this MDL DELETES it. The microflow behaves the same either way (a merge with one incoming path is a no-op), but the node disappears from the diagram (mxcli #923)
  -- WARNING: the merge at (635, 145) is not represented in this description - it joins no decision and no error handler, so re-executing this MDL DELETES it. The microflow behaves the same either way (a merge with one incoming path is a no-op), but the node disappears from the diagram (mxcli #923)
  -- WARNING: the merge at (1550, -140) is not represented in this description - it joins no decision and no error handler, so re-executing this MDL DELETES it. The microflow behaves the same either way (a merge with one incoming path is a no-op), but the node disappears from the diagram (mxcli #923)
  declare $IsValid Boolean = true;
  @merge(475, 635)
  @caption 'TicketActionType'
  if $OfflineTicketAction/TicketActionType != empty then
    $Asset_NewTicket = call microflow AssetsClient.Asset_Get_BySystemID(SystemID = $OfflineTicketAction/AssetSystemID);
    @merge(475, 635)
    @caption 'Asset available?'
    if $Asset_NewTicket != empty then
      @merge(1550, 245)
      @caption 'Type'
      case $OfflineTicketAction/TicketActionType
        when Asset_confirmed, Asset_changed then
          $Ticket = call microflow TicketManagement.Ticket_Get_BySystemID(SystemID = $OfflineTicketAction/ObjectID);
          @merge(1550, 245)
          @caption 'found?'
          if $Ticket != empty then
            @merge(1550, 245)
            @caption 'last changed by current user?'
            if not($Ticket/TicketManagement.Ticket_Account_LastChangedBy = $currentUser) then
              @anchor(from: top)
              @merge(1550, 375)
              @caption 'sync allowed?'
              if $LastDownload != empty
and
$LastDownload >= $Ticket/changedDate then
              else
                @anchor(from: bottom, to: top)
                set $IsValid = false;
                @anchor(to: top)
                call microflow Synchronization.OfflineAction_AppendReviewMessage(OfflineAction = $OfflineTicketAction, Message = 'This object was changed by another user after your last sync date.
Therefore, this offline action cannot be processed.');
              end if;
              join shared5;
            end if;
          else
            @anchor(from: bottom, to: top)
            set $IsValid = false;
            @anchor(from: bottom, to: top)
            call microflow Synchronization.OfflineAction_AppendReviewMessage(OfflineAction = $OfflineTicketAction, Message = 'The related Ticket is not available on web, this is a system error, contact your system administrator.');
            join shared3;
          end if;
        when (empty) then
          join shared2;
        when Ticket_created then
          @anchor(from: bottom)
          @merge(1550, 145)
          @caption ' (Short)Description?'
          if trim($OfflineTicketAction/ShortDescription) != '' and
trim($OfflineTicketAction/Description) != '' then
          else
            @anchor(from: bottom, to: top)
            set $IsValid = false;
            @anchor(from: bottom, to: top)
            call microflow Synchronization.OfflineAction_AppendReviewMessage(OfflineAction = $OfflineTicketAction, Message = 'This offline action does not have the necessary (Short)Description thus could not be processed. This is a system error. Please contact the system administrator.');
          end if;
      end case;
    else
      @anchor(from: bottom, to: top)
      set $IsValid = false;
      @anchor(from: bottom, to: top)
      call microflow Synchronization.OfflineAction_AppendReviewMessage(OfflineAction = $OfflineTicketAction, Message = 'The related Asset is not available on web.');
      join shared1;
    end if;
  else
    @anchor(from: bottom, to: top)
    set $IsValid = false;
    @anchor(from: bottom, to: top)
    call microflow Synchronization.OfflineAction_AppendReviewMessage(OfflineAction = $OfflineTicketAction, Message = 'The type of this offline action could not be identified. 
This is a system error. Please contact the system administrator.');
    join shared1;
  end if;
  join shared4;
  merge shared1;
  join shared2;
  merge shared2;
  join shared3;
  merge shared3;
  join shared5;
  merge shared4;
  return $IsValid;
  merge shared5;
  join shared4;
end;

create or modify rule Synchronization.Rule_SuggestedPart_HasChanged (
  $SuggestedPart: AssetsClient.SuggestedPart,
  $NativeSuggestedPart: NativeMobilePart.NativeSuggestedPart
)
returns Boolean
folder 'Objects/SuggestedPart'
begin
  declare $HasChanged Boolean = false;
  retrieve $NativeWorkOrder from NativeMobile.NativeWorkOrder
    where [NativeMobilePart.NativeSuggestedPart_NativeWorkOrder = $NativeSuggestedPart]
    [IsDeleted = false()]
    first;
  retrieve $WorkOrder from TicketManagement.WorkOrder
    where PublicID = $SuggestedPart/WorkOrderPublicID
    first;
  retrieve $NativePart from NativeMobilePart.NativePart
    where [NativeMobilePart.NativeSuggestedPart_NativePart = $NativeSuggestedPart]
    [IsDeleted = false()]
    first;
  retrieve $Part from $SuggestedPart/AssetsClient.SuggestedPart_Part;
  @merge(1165, 230)
  @caption 'values changed?'
  if $NativePart/SystemID != $Part/SystemID or
$NativeWorkOrder/SystemID != $WorkOrder/SystemID or
$NativeSuggestedPart/Quantity != $SuggestedPart/Quantity or
$NativeSuggestedPart/IsUsed != $SuggestedPart/IsUsed then
    set $HasChanged = true;
  end if;
  return $HasChanged;
end;

create or modify microflow Synchronization.SuggestedPart_ProcessUpdatingNativeSuggestedPart (
  $SuggestedPart: AssetsClient.SuggestedPart,
  $NativeSuggestedPart: NativeMobilePart.NativeSuggestedPart
)
folder 'Objects/SuggestedPart'
export level api
begin
  retrieve $Part from $SuggestedPart/AssetsClient.SuggestedPart_Part;
  $NativePart = call microflow NativeMobilePart.NativePart_Get_BySystemID(SystemID = $Part/SystemID, NativePartList_optional = empty);
  retrieve $WorkOrder from TicketManagement.WorkOrder
    where PublicID = $SuggestedPart/WorkOrderPublicID
    first;
  $NativeWorkOrder = call microflow NativeMobile.NativeWorkOrder_GetOrCreate(SystemID = $WorkOrder/SystemID, NativeWorkOrderList_optional = empty);
  change $NativeSuggestedPart (NativeMobilePart.NativeSuggestedPart_NativeWorkOrder = $NativeWorkOrder, NativeMobilePart.NativeSuggestedPart_NativePart = $NativePart, Quantity = $SuggestedPart/Quantity, IsUsed = $SuggestedPart/IsUsed);
  call microflow NativeMobilePart.NativeSuggestedPart_Save(NativeSuggestedPart = $NativeSuggestedPart);
  @annotation(text: 'Hotfix to prevent the database from deleting this native workorder due to the status being autocommitted', position: (870, 50), size: (230, 50))
  call microflow NativeMobile.NativeWorkorder_Save(NativeWorkOrder = $NativeWorkOrder);
  return;
end;

create or modify microflow TicketManagement.ACT_Workorder_CancelEdit (
  $WorkOrder: TicketManagement.WorkOrder
)
folder 'Pages/WorkOrder/Edit'
begin
  retrieve $SelectedFormList from $WorkOrder/Form.SelectedForm_WorkOrder;
  loop $IteratorSelectedForm in $SelectedFormList
  begin
    rollback $IteratorSelectedForm;
  end loop;
  retrieve $WorkOrderAssignmentHelperList from $WorkOrder/TicketManagement.WorkOrderAssignmentHelper_WorkOrder;
  delete $WorkOrderAssignmentHelperList;
  rollback $WorkOrder refresh;
  close page;
  return;
end;

grant execute on microflow TicketManagement.ACT_Workorder_CancelEdit to TicketManagement.WorkorderEditAll;

create or modify microflow TicketManagement.AppointmentList_Delete (
  $AppointmentList: List of TicketManagement.Appointment
)
folder 'Objects/Appointment/Delete'
export level api
begin
  $WorkOrderList_ToRecalculate = create list of TicketManagement.WorkOrder;
  $NativeAppointmentList_ToDelete = create list of NativeMobile.NativeAppointment;
  $AppointmentAssignment_ToDelete = create list of TicketManagement.AppointmentAssignment;
  $TimeRegistrationList_ToDelete = create list of TimeRegistration.TimeRegistration;
  $NotResolvedReasonList_ToDelete = create list of Reason.NotResolvedReason;
  $OfflineAppointmentActionList_ToDelete = create list of Synchronization.OfflineAppointmentAction;
  loop $IteratorAppointment in $AppointmentList
  begin
    retrieve $AppointmentAssignmentList from $IteratorAppointment/TicketManagement.AppointmentAssignment_Appointment;
    add $AppointmentAssignmentList to $AppointmentAssignment_ToDelete;
    retrieve $WorkOrder from $IteratorAppointment/TicketManagement.Appointment_WorkOrder;
    add $WorkOrder to $WorkOrderList_ToRecalculate;
    retrieve $NotResolvedReasonList from $IteratorAppointment/Reason.NotResolvedReason_Appointment;
    add $NotResolvedReasonList to $NotResolvedReasonList_ToDelete;
    retrieve $OfflineAppointmentActionList from $IteratorAppointment/Synchronization.OfflineAppointmentAction_Appointment;
    add $OfflineAppointmentActionList to $OfflineAppointmentActionList_ToDelete;
    retrieve $TimeRegistrationList from $IteratorAppointment/TimeRegistration.TimeRegistration_Appointment;
    add $TimeRegistrationList to $TimeRegistrationList_ToDelete;
    $NativeAppointment = call microflow NativeMobile.NativeAppointment_Get_BySystemID(SystemID = $IteratorAppointment/SystemID, NativeAppointmentList_optional = empty);
    add $NativeAppointment to $NativeAppointmentList_ToDelete;
  end loop;
  call microflow NativeMobile.NativeAppointmentList_Delete(NativeAppointmentList = $NativeAppointmentList_ToDelete);
  call microflow TimeRegistration.TimeRegistrationList_Delete(TimeRegistrationList = $TimeRegistrationList_ToDelete);
  call microflow Reason.NotResolvedReasonList_Delete(NotResolvedReasonList = $NotResolvedReasonList_ToDelete);
  call microflow Synchronization.OfflineAppointmentActionList_Delete(OfflineAppointmentActionList = $OfflineAppointmentActionList_ToDelete);
  call microflow TicketManagement.AppointmentAssignmentList_Delete(AppointmentAssignmentList = $AppointmentAssignment_ToDelete);
  delete $AppointmentList;
  call microflow TicketManagement.WorkOrderList_Save(WorkOrderList = $WorkOrderList_ToRecalculate);
  return;
end;

create or modify microflow TicketManagement.DS_Asset_GetRelevantSLA (
  $Asset: AssetsClient.Asset
)
returns CustomerManagement.SLA
folder 'Pages/TicketNP/Malfunction'
begin
  $SLA = call microflow AssetsClient.Asset_GetRelevantSLA(Asset = $Asset);
  @caption 'SLA found?'
  if $SLA != empty then
    return $SLA;
  else
    @anchor(to: top)
    return empty;
  end if;
end;

grant execute on microflow TicketManagement.DS_Asset_GetRelevantSLA to TicketManagement.TicketEditAll;

create or modify microflow TicketManagement.Private_Ticket_DetermineSLA (
  $Ticket: TicketManagement.Ticket
)
returns Integer
folder 'Objects/Ticket/Private/Calculations'
begin
  declare $SLAResponseTime Integer = empty;
  @caption 'Not cancelled?'
  if TicketManagement.Rule_Ticket_IsNotCancelled(Ticket = $Ticket) then
    @caption 'Malfunction?'
    if TicketManagement.Rule_TicketType_IsMalfunction(TicketType = $Ticket/TicketManagement.Ticket_TicketType/TicketManagement.TicketType) then
      retrieve $Asset from $Ticket/TicketManagement.Ticket_Asset;
      $SLA = call microflow AssetsClient.Asset_GetRelevantSLA(Asset = $Asset);
      @caption 'SLA?'
      if $SLA != empty then
        retrieve $Priority from $Ticket/TicketManagement.Ticket_Priority;
        @caption 'Priority level?'
        case $Priority/PriorityLevel
          when A_High then
            set $SLAResponseTime = 60 * $SLA/HighPriorityResponseTime;
            return $SLAResponseTime;
          when B_Medium then
            set $SLAResponseTime = 60 * $SLA/MediumPriorityResponseTime;
            return $SLAResponseTime;
          when C_Low then
            set $SLAResponseTime = 60 * $SLA/LowPriorityResponseTime;
            return $SLAResponseTime;
          when (empty) then
            @anchor(to: top)
            return $SLAResponseTime;
        end case;
      else
        @anchor(to: top)
        return $SLAResponseTime;
      end if;
    else
      @anchor(to: top)
      return $SLAResponseTime;
    end if;
  else
    @anchor(to: top)
    return $SLAResponseTime;
  end if;
end;

create or modify microflow TicketManagement.Private_WorkOrder_TechnicianPicker_GetMalfunctionTechnician (
  $MinimumDate: DateTime,
  $Asset: AssetsClient.Asset
)
returns Technician.Technician
folder 'Objects/WorkOrder/Private/TechnicianPicker'
begin
  @annotation(text: 'Get all Technicians in Region with active malfunction roster', position: (-145, 35), size: (230, 50))
  retrieve $TechnicianList from Technician.Technician
    where [Technician.Technician_ServiceRegionManager/Administration.Account /Technician.Technician_ServiceRegionManager/Technician.Technician /TechnicianID = $Asset/PreferredTechnicianID]
    [RosterManagement.TechnicianRoster_Technician/RosterManagement.TechnicianRoster [RosterType = 'Malfunction'][StartDate < $MinimumDate][EndDate > $MinimumDate]]
    sort by TechnicianID asc;
  $TechnicianList_ToPick = create list of Technician.Technician;
  loop $IteratoTechnician in $TechnicianList
  begin
    @caption 'Technician is eligible'
    @annotation(text: 'Technicians with set appointments, should not be used. If one is found, use it.', position: (260, 20), size: (240, 100))
    if TicketManagement.Rule_WorkOrder_TechnicianPicker_IsEligible(MinimumDate = $MinimumDate, Technician = $IteratoTechnician, NeedMalfunction = true) then
      add $IteratoTechnician to $TechnicianList_ToPick;
      break;
    else
      @anchor(to: top)
      continue;
    end if;
  end loop;
  $Technician = head $TechnicianList_ToPick;
  return $Technician;
end;

create or modify microflow TicketManagement.TicketNP_Asset_RequiresContractWarning (
  $TicketNP: TicketManagement.TicketNP
)
returns Boolean
folder 'Objects/TicketNP/Malfunction'
export level api
begin
  @caption 'asset requires warning'
  if AssetsClient.Rule_Asset_RequiresNoContractNotification(Asset = $TicketNP/TicketManagement.TicketNP_Asset/AssetsClient.Asset) then
    return true;
  else
    @anchor(to: top)
    return false;
  end if;
end;

create or modify microflow TicketManagement.TicketNP_IsChoosenTechnicianAssigned (
  $Ticket: TicketManagement.Ticket,
  $TicketNP: TicketManagement.TicketNP
)
folder 'Pages/TicketNP/Malfunction'
begin
  @caption 'Notification?'
  if $TicketNP/AssignTechnician = TicketManagement.ENUM_Malfunction_AssignTechnician.PreferredTechnician then
    retrieve $TicketAsset from $Ticket/TicketManagement.Ticket_Asset;
    $Technician_Preferred = call microflow AssetsClient.Asset_GetPreferredTechnician(Asset = $TicketAsset);
    retrieve $Technician_Assigned from Technician.Technician
    where TicketManagement.WorkOrderAssignment_Technician/TicketManagement.WorkOrderAssignment /TicketManagement.WorkOrderAssignment_WorkOrder/TicketManagement.WorkOrder /TicketManagement.WorkOrder_Ticket = $Ticket
    first;
    @caption 'Is Preferred available?'
    if $Technician_Assigned = $Technician_Preferred then
      return;
    else
      @anchor(from: bottom, to: top)
      show message 'The preferred technician wasn''t available so another available technician is assigned. Please check the workorder to see the currently assigned technician.' type Information blocking;
      @anchor(to: top)
      return;
    end if;
  else
    @anchor(to: top)
    return;
  end if;
end;

create or modify microflow TicketManagement.TicketNP_Malfunction_Validate (
  $TicketNP: TicketManagement.TicketNP
)
returns Boolean
folder 'Objects/TicketNP/Malfunction/Validations'
export level api
begin
  -- WARNING: the merge at (470, -90) is not represented in this description - it joins no decision and no error handler, so re-executing this MDL DELETES it. The microflow behaves the same either way (a merge with one incoming path is a no-op), but the node disappears from the diagram (mxcli #923)
  -- WARNING: the merge at (1690, -90) is not represented in this description - it joins no decision and no error handler, so re-executing this MDL DELETES it. The microflow behaves the same either way (a merge with one incoming path is a no-op), but the node disappears from the diagram (mxcli #923)
  declare $IsValid Boolean = true;
  $IsValidDraft = call microflow TicketManagement.TicketNP_Malfunction_ValidateDraft(TicketNP = $TicketNP);
  set $IsValid = $IsValid
and
$IsValidDraft;
  $SLA = call microflow AssetsClient.Asset_GetRelevantSLA(Asset = $TicketNP/TicketManagement.TicketNP_Asset/AssetsClient.Asset);
  @merge(305, 200)
  @caption 'Customer reference required?'
  if $SLA != empty
and $SLA/NeedsMandatoryTaskNumber then
    @merge(305, 200)
    @caption 'Needed now?'
    if not($TicketNP/AddCustomerReferenceLater) then
      @merge(305, 200)
      @caption 'Customer reference?'
      if not(trim($TicketNP/CustomerReference) != '') then
        @anchor(to: top)
        set $IsValid = false;
        @anchor(from: top)
        validation feedback $TicketNP/CustomerReference message 'Provide a customer reference.';
      end if;
    end if;
  end if;
  @merge(1690, 200)
  @caption 'Send to which Technician?'
  case $TicketNP/AssignTechnician
    when Recurring_for_specific_technician, SpecificTechnician then
      @merge(975, 5)
      @caption 'Technician?'
      if $TicketNP/TicketManagement.TicketNP_Technician != empty then
      else
        @anchor(to: top)
        set $IsValid = false;
        @anchor(from: top)
        validation feedback $TicketNP/TicketManagement.TicketNP_Technician message 'Select a technician';
      end if;
      @merge(1335, 5)
      @caption 'ExpectedStartTime?'
      if $TicketNP/ExpectedStartTime != empty then
      else
        @anchor(to: top)
        set $IsValid = false;
        @anchor(from: top)
        validation feedback $TicketNP/ExpectedStartTime message 'Select an expected time of arrival.';
      end if;
      join shared1;
    when PreferredTechnician then
      @merge(975, 200)
      @caption 'Preferred Technician?'
      if $TicketNP/TicketManagement.TicketNP_Asset/AssetsClient.Asset/PreferredTechnicianID != empty then
      else
        @anchor(to: top)
        set $IsValid = false;
        @anchor(from: top)
        validation feedback $TicketNP/AssignTechnician message 'No preferred technician has been set for this Asset.';
      end if;
      $Technician = call microflow TicketManagement.WorkOrder_TechnicianPicker(Asset = $TicketNP/TicketManagement.TicketNP_Asset/AssetsClient.Asset, WorkOrder_optional = empty);
      @merge(1540, 200)
      @caption 'Any?'
      if $Technician != empty then
      else
        @anchor(to: top)
        set $IsValid = false;
        @anchor(from: top)
        show message 'Can''t send notification since no technician is available. Please select a technician manually for this malfunction.' type Information blocking;
      end if;
    when (empty) then
      @anchor(to: top)
      set $IsValid = false;
      @anchor(from: top)
      validation feedback $TicketNP/AssignTechnician message 'Choose an option.';
    when NoWorkorder then
      join shared1;
  end case;
  join shared2;
  merge shared1;
  join shared2;
  merge shared2;
  @merge(2500, 200)
  @caption 'is recurring?'
  if $TicketNP/AssignTechnician = TicketManagement.ENUM_Malfunction_AssignTechnician.Recurring_for_specific_technician then
    @merge(2180, 200)
    @caption 'interval?'
    if $TicketNP/OccurrenceInterval != empty then
    else
      @anchor(to: top)
      set $IsValid = false;
      @anchor(from: top)
      validation feedback $TicketNP/OccurrenceInterval message 'Pick an interval.';
    end if;
    @merge(2500, 200)
    @caption 'number of occurrences?'
    if not($TicketNP/NumberOfOccurrences != empty) then
      @anchor(to: top)
      set $IsValid = false;
      @anchor(from: top)
      validation feedback $TicketNP/NumberOfOccurrences message 'Enter number of occurrences.';
    end if;
  end if;
  return $IsValid;
end;

create or modify microflow TicketManagement.TicketNP_Malfunction_ValidateEdit (
  $TicketNP: TicketManagement.TicketNP
)
returns Boolean
folder 'Objects/TicketNP/Malfunction/Validations'
export level api
begin
  declare $IsValid Boolean = true;
  $IsValidDraft = call microflow TicketManagement.TicketNP_Malfunction_ValidateDraft(TicketNP = $TicketNP);
  set $IsValid = $IsValid
and
$IsValidDraft;
  $SLA = call microflow AssetsClient.Asset_GetRelevantSLA(Asset = $TicketNP/TicketManagement.TicketNP_Asset/AssetsClient.Asset);
  @merge(810, 200)
  @caption 'Customer reference required?'
  if $SLA != empty
and $SLA/NeedsMandatoryTaskNumber then
    @merge(810, 200)
    @caption 'Needed now?'
    if not($TicketNP/AddCustomerReferenceLater) then
      @merge(810, 200)
      @caption 'Customer reference?'
      if not(trim($TicketNP/CustomerReference) != '') then
        @anchor(to: top)
        set $IsValid = false;
        @anchor(from: top)
        validation feedback $TicketNP/CustomerReference message 'Provide a customer reference.';
      end if;
    end if;
  end if;
  return $IsValid;
end;

create or modify microflow TicketManagement.WorkOrderList_Delete (
  $WorkOrderList: List of TicketManagement.WorkOrder
)
folder 'Objects/WorkOrder'
export level api
begin
  $TechnicianList_ToUpdate = create list of Technician.Technician;
  $TicketList_ToDelete = create list of TicketManagement.Ticket;
  $AppointmentList_ToDelete = create list of TicketManagement.Appointment;
  $NativeWorkOrderList_ToDelete = create list of NativeMobile.NativeWorkOrder;
  $WorkOrderAssignmentList_ToDelete = create list of TicketManagement.WorkOrderAssignment;
  $SelectedFormList_ToDelete = create list of Form.SelectedForm;
  $NoteList_ToDelete = create list of Note.Note;
  loop $IteratorWorkOrder in $WorkOrderList
  begin
    $TechnicianList = call microflow TicketManagement.WorkOrder_GetTechniciansToUpdate(WorkOrder = $IteratorWorkOrder);
    add $TechnicianList to $TechnicianList_ToUpdate;
    retrieve $Ticket from $IteratorWorkOrder/TicketManagement.WorkOrder_Ticket;
    add $Ticket to $TicketList_ToDelete;
    retrieve $AppointmentList from $IteratorWorkOrder/TicketManagement.Appointment_WorkOrder;
    add $AppointmentList to $AppointmentList_ToDelete;
    $NativeWorkOrder = call microflow NativeMobile.NativeWorkOrder_Get_BySystemID(SystemID = $IteratorWorkOrder/SystemID, NativeWorkOrderList_optional = empty);
    add $NativeWorkOrder to $NativeWorkOrderList_ToDelete;
    retrieve $WorkOrderAssignmentList from $IteratorWorkOrder/TicketManagement.WorkOrderAssignment_WorkOrder;
    add $WorkOrderAssignmentList to $WorkOrderAssignmentList_ToDelete;
    retrieve $SelectedFormList from $IteratorWorkOrder/Form.SelectedForm_WorkOrder;
    add $SelectedFormList to $SelectedFormList_ToDelete;
    retrieve $NoteList from $IteratorWorkOrder/Note.Note_WorkOrder;
    add $NoteList to $NoteList_ToDelete;
    call microflow Synchronization.OfflineAction_DeleteByID(ObjectID = $IteratorWorkOrder/SystemID);
  end loop;
  call microflow TicketManagement.WorkOrderAssignmentList_Delete(WorkOrderAssignmentList = $WorkOrderAssignmentList_ToDelete);
  call microflow Form.SelectedFormList_Delete(SelectedFormList = $SelectedFormList_ToDelete);
  call microflow Note.NoteList_Delete(NoteList = $NoteList_ToDelete);
  call microflow TicketManagement.AppointmentList_Delete(AppointmentList = $AppointmentList_ToDelete);
  call microflow NativeMobile.NativeWorkOrderList_Delete(NativeWorkOrderList = $NativeWorkOrderList_ToDelete);
  delete $WorkOrderList refresh;
  call microflow TicketManagement.TicketList_Save(TicketList = $TicketList_ToDelete);
  call microflow Technician.TechnicianList_UpdateWebSyncHelpers(TechnicianList = $TechnicianList_ToUpdate);
  return;
end;

create or modify microflow TicketManagement.WorkOrder_CommitSelectedParts (
  $WorkOrder: TicketManagement.WorkOrder
)
folder 'Objects/WorkOrder'
export level api
begin
  -- increment 7: suggested parts / selected tools are owned by the Assets & Parts app; planning them on a
  -- work order is a hand-off (no REST create in AssetsAPIv2 yet). Kept as a no-op so callers stay unchanged.
  return;
end;

create or modify microflow TicketManagement.WorkOrder_CommitSelectedTools (
  $WorkOrder: TicketManagement.WorkOrder
)
folder 'Objects/WorkOrder'
export level api
begin
  -- increment 7: suggested parts / selected tools are owned by the Assets & Parts app; planning them on a
  -- work order is a hand-off (no REST create in AssetsAPIv2 yet). Kept as a no-op so callers stay unchanged.
  return;
end;

/**
 * This microflow facilitates the automatic assignment of technicians to work orders. A common implementation is the set a preferred technician for an asset, which then can automatically get assigned if it fits in their roster. Any custom logic for this functionality can be added in this microflow.
 * The minimumDate is the moment in time which needs to be included in a technician's schedule to be able to plan this work order.
 */
create or modify microflow TicketManagement.WorkOrder_TechnicianPicker_GetEligibleLinkedTechnician (
  $MinimumDate: DateTime,
  $Asset: AssetsClient.Asset,
  $WorkOrder_optional: TicketManagement.WorkOrder,
  $TechnicianList_Declined: List of Technician.Technician
)
returns Technician.Technician
folder 'Objects/WorkOrder'
begin
  @annotation(id: n1, text: 'Dummy action to prevent warnings. Please remove when customizing this microflow.', position: (-515, -230), size: (230, 50))
  declare $DummyVariable Boolean = $WorkOrder_optional !=empty;
  @annotation(id: n1)
  set $DummyVariable = true;
  $Technician_Preferred = call microflow AssetsClient.Asset_GetPreferredTechnician(Asset = $Asset);
  @anchor(from: bottom)
  @merge(355, 70)
  @caption 'Preferred?'
  if $Technician_Preferred != empty then
    $Technician_Preferred_Declined = intersect $TechnicianList_Declined with $Technician_Preferred;
    @anchor(from: bottom)
    @merge(355, 70)
    @caption 'Not declined earlier'
    if $Technician_Preferred_Declined = empty then
      @caption 'Technician is eligible'
      if TicketManagement.Rule_WorkOrder_TechnicianPicker_IsEligible(MinimumDate = $MinimumDate, Technician = $Technician_Preferred, NeedMalfunction = false) then
        return $Technician_Preferred;
      end if;
    end if;
  end if;
  join shared1;
  merge shared1;
  @anchor(to: top)
  return empty;
end;

