-- "My" access rules that walked Customer/Contract <- slice Asset <- Ticket: XPath cannot cross apps (hand-off, as in
-- increment 6: a REST-fed copy of the asset -> customer key on the ticket would carry it)
grant read (CustomerID, CustomerName, "Email", PhoneNumber, ReferenceNumber) on entity CustomerManagement.Customer to CustomerManagement.ViewMy where [false()];
grant read (Number, "Description") on entity CustomerManagement.Contract to CustomerManagement.ViewMy where [false()];

-- data removal of slice-owned rows is the slice's job
drop microflow AppSettings.DataRemoval_RemoveWebData;
create or modify microflow AppSettings.DataRemoval_RemoveWebData ()
folder 'Objects/DataRemoval/Web'
export level api
begin
  call microflow AppSettings.DataRemoval_TimeRegistrationList();
  call microflow AppSettings.DataRemoval_AppointmentList();
  call microflow AppSettings.DataRemoval_WorkOrderAssignmentList();
  call microflow AppSettings.DataRemoval_WorkOrderList();
  call microflow AppSettings.DataRemoval_ImageList();
  call microflow AppSettings.DataRemoval_DocumentList();
  call microflow AppSettings.DataRemoval_AttachmentList();
  call microflow AppSettings.DataRemoval_TicketLogList();
  call microflow AppSettings.DataRemoval_InstanceOptionList();
  call microflow AppSettings.DataRemoval_InstanceItemImageList();
  call microflow AppSettings.DataRemoval_InstanceItemList();
  call microflow AppSettings.DataRemoval_InstanceFormList();
  call microflow AppSettings.DataRemoval_SelectedFormList();
  call microflow AppSettings.DataRemoval_RosterList();
  call microflow AppSettings.DataRemoval_TicketList();
  return;
end;

