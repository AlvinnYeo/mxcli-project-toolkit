mdl 1;
-- CUT STUB entities need module roles too (decompose-app Stage 5, CE2729 x108 at Production): one read-only stub role per
-- stub module, read * on every stub entity, granted to every FSM user role. Stubs hold no rows; this only lets pages bind.
create or modify module role TicketManagement.StubRead description 'CUT STUB read access (increment 8)';
grant read * on entity TicketManagement.Appointment to TicketManagement.StubRead;
grant read * on entity TicketManagement.AppointmentAssignment to TicketManagement.StubRead;
grant read * on entity TicketManagement.Priority to TicketManagement.StubRead;
grant read * on entity TicketManagement.Ticket to TicketManagement.StubRead;
grant read * on entity TicketManagement.WorkOrder to TicketManagement.StubRead;
grant read * on entity TicketManagement.WorkOrderAssignment to TicketManagement.StubRead;
create or modify module role AssetManagement.StubRead description 'CUT STUB read access (increment 8)';
grant read * on entity AssetManagement.Asset to AssetManagement.StubRead;
create or modify module role WarehouseManagement.StubRead description 'CUT STUB read access (increment 8)';
grant read * on entity WarehouseManagement.Warehouse to WarehouseManagement.StubRead;
create or modify module role FeatureToggle.StubRead description 'CUT STUB read access (increment 8)';
grant read * on entity FeatureToggle.FeatureToggle to FeatureToggle.StubRead;
create or modify module role AppSettings.StubRead description 'CUT STUB read access (increment 8)';
grant read * on entity AppSettings.ApplicationSettings to AppSettings.StubRead;
create or modify module role NativeMobile.StubRead description 'CUT STUB read access (increment 8)';
grant read * on entity NativeMobile.NativeAppointment to NativeMobile.StubRead;
create or modify module role NativeMobileTimeRegistration.StubRead description 'CUT STUB read access (increment 8)';
grant read * on entity NativeMobileTimeRegistration.NativeRegistrationCode to NativeMobileTimeRegistration.StubRead;
grant read * on entity NativeMobileTimeRegistration.NativeTimeRegistration to NativeMobileTimeRegistration.StubRead;
grant read * on entity NativeMobileTimeRegistration.NativeWorkBreak to NativeMobileTimeRegistration.StubRead;
create or modify module role Synchronization.StubRead description 'CUT STUB read access (increment 8)';
grant read * on entity Synchronization.WebSyncHelper to Synchronization.StubRead;
create or modify module role Utils.StubRead description 'CUT STUB read access (increment 8)';
grant read * on entity Utils.ValidationFeedback to Utils.StubRead;
alter user role CallCenterEmployee add module roles (TicketManagement.StubRead, AssetManagement.StubRead, WarehouseManagement.StubRead, FeatureToggle.StubRead, AppSettings.StubRead, NativeMobile.StubRead, NativeMobileTimeRegistration.StubRead, Synchronization.StubRead, Utils.StubRead);
alter user role FunctionalAdministrator add module roles (TicketManagement.StubRead, AssetManagement.StubRead, WarehouseManagement.StubRead, FeatureToggle.StubRead, AppSettings.StubRead, NativeMobile.StubRead, NativeMobileTimeRegistration.StubRead, Synchronization.StubRead, Utils.StubRead);
alter user role Mechanic add module roles (TicketManagement.StubRead, AssetManagement.StubRead, WarehouseManagement.StubRead, FeatureToggle.StubRead, AppSettings.StubRead, NativeMobile.StubRead, NativeMobileTimeRegistration.StubRead, Synchronization.StubRead, Utils.StubRead);
alter user role ServiceDeskEmployee add module roles (TicketManagement.StubRead, AssetManagement.StubRead, WarehouseManagement.StubRead, FeatureToggle.StubRead, AppSettings.StubRead, NativeMobile.StubRead, NativeMobileTimeRegistration.StubRead, Synchronization.StubRead, Utils.StubRead);
alter user role ServiceRegionManager add module roles (TicketManagement.StubRead, AssetManagement.StubRead, WarehouseManagement.StubRead, FeatureToggle.StubRead, AppSettings.StubRead, NativeMobile.StubRead, NativeMobileTimeRegistration.StubRead, Synchronization.StubRead, Utils.StubRead);
alter user role TechnicalAdministrator add module roles (TicketManagement.StubRead, AssetManagement.StubRead, WarehouseManagement.StubRead, FeatureToggle.StubRead, AppSettings.StubRead, NativeMobile.StubRead, NativeMobileTimeRegistration.StubRead, Synchronization.StubRead, Utils.StubRead);
