-- widgets: replaced in place (alter page), not re-created from describe — the describe round trip of PageContext_View
-- failed at exec (`dynamictext text14: Visible: Status in (…): Scheduler.PlannerContext_WorkOrder_Selected has no attribute Status`)
alter page Scheduler.PageContext_View {
  replace textBox2 with {
    dynamictext textBox2 (Content: 'HAND-OFF: Location is served by the monolith (asset not published)')
  };
  replace textBox7 with {
    dynamictext textBox7 (Content: 'HAND-OFF: Asset ID is served by the monolith (asset not published)')
  };
  replace textBox14 with {
    dynamictext textBox14 (Content: 'HAND-OFF: Asset name is served by the monolith (asset not published)')
  };
};
alter snippet Scheduler.Snippet_Technician_Tooltip {
  replace dataView1 with {
    dynamictext dataView1 (Content: 'HAND-OFF: working location (asset) is served by the monolith')
  };
};
alter page Technician.Technician_ConfirmRemove {
  replace grid4 with {
    datagrid grid4 (
        DataSource: database from TicketManagement.WorkOrder where [Status = 'In_progress'] [TicketManagement.Appointment_WorkOrder/TicketManagement.Appointment/TicketManagement.AppointmentAssignment_Appointment/TicketManagement.AppointmentAssignment/TicketManagement.AppointmentAssignment_Technician = $Technician] sort by DisplayStart desc,
        Selection: Single
      ) {
        -- Context: $currentObject (TicketManagement.WorkOrder), $grid4 (selection)
        column (Attribute: Description, Caption: 'Description')
        column (Attribute: WorkOrder_Ticket/CreationTime, Caption: 'Creation date')
        column (Attribute: WorkOrder_Skill/SkillName, Caption: 'Skills')
        column (Attribute: WorkOrder_Ticket/Ticket_Priority/Description, Caption: 'Priority')
        column (Attribute: Status, Caption: 'Status')
        column (Attribute: DisplayStart, Caption: 'Start of work')
        column (Attribute: DisplayEnd, Caption: 'End of work')
      }
  };
  replace grid3 with {
    datagrid grid3 (
        DataSource: database from TicketManagement.WorkOrder where [Status != 'Finished'] [Status != 'In_progress'] [TicketManagement.Appointment_WorkOrder/TicketManagement.Appointment/TicketManagement.AppointmentAssignment_Appointment/TicketManagement.AppointmentAssignment/TicketManagement.AppointmentAssignment_Technician = $Technician] sort by DisplayStart desc,
        Selection: Single
      ) {
        -- Context: $currentObject (TicketManagement.WorkOrder), $grid3 (selection)
        column (Attribute: Description, Caption: 'Description')
        column (Attribute: WorkOrder_Skill/SkillName, Caption: 'Skills')
        column (Attribute: WorkOrder_Ticket/Ticket_Priority/Description, Caption: 'Priority')
        column (Attribute: Status, Caption: 'Status')
        column (Attribute: DisplayStart, Caption: 'Start of work')
        column (Attribute: DisplayEnd, Caption: 'End of work')
        column (Attribute: SetOnSpecificTechnician, Caption: 'Specific to this technician')
        column (Attribute: SetOnSpecificTime, Caption: 'On specific time')
      }
  };
};
alter snippet Technician.Snippet_Technician_DataTabs {
  replace grid1 with {
    datagrid grid1 (
        DataSource: database from TicketManagement.WorkOrder where [TicketManagement.WorkOrderAssignment_WorkOrder/TicketManagement.WorkOrderAssignment[Status = 'Auto_accepted' or Status = 'Accepted' or Status = 'Pending']/TicketManagement.WorkOrderAssignment_Technician = $Technician] sort by DisplayStart asc,
        Selection: Single
      ) {
        -- Context: $currentObject (TicketManagement.WorkOrder), $grid1 (selection)
        column (Attribute: WorkOrder_Ticket/Description, Caption: 'Ticket description')
        column (Attribute: WorkOrder_Ticket/CreationTime, Caption: 'Ticket Creation time')
        column (Attribute: WorkOrder_Skill/SkillName, Caption: 'Skills')
        column (Attribute: WorkOrder_Ticket/Ticket_Priority/PriorityLevel, Caption: 'Priority')
        column (Attribute: Status, Caption: 'Status')
        column (Attribute: DisplayStart, Caption: 'Work start')
        column (Attribute: DisplayEnd, Caption: 'Work end')
        column (Caption: ' ', ShowContentAs: customContent) {
          actionbutton actionButton10 (
            Caption: 'Open',
            Action: show page TicketManagement.WorkOrder_View(WorkOrder = $currentObject)
          )
        }
      }
  };
};

-- Roster ViewMy (Mechanic) XPath walks Roster -> asset -> ticket -> assignment -> technician -> account across both apps:
-- no external entity can carry it (seam limits -> XPath). Equivalent of [false()]: the rule is removed (hand-off, Mobile).
revoke all on entity RosterManagement.Roster from RosterManagement.ViewMy;
