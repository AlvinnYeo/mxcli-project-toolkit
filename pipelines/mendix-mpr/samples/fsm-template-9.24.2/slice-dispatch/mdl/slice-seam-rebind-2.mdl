drop microflow Scheduler.PlannerContext_RefreshIfNeeded;
create or modify microflow Scheduler.PlannerContext_RefreshIfNeeded (
  @position(330, 60)
  $Appointment: TicketManagement.Appointment
)
folder 'Objects/PlannerContext'
begin
  @start(330, 200)
  @position(455, 200)
  @curve(from: (30, 0), to: (-15, 0))
  retrieve $PlannerContext from Scheduler.PlannerContext
    where Scheduler.PlannerContext_Session = $currentSession
    first;
  @position(610, 200)
  @caption 'PlannerContext?'
  if $PlannerContext != empty then
    @curve(from: (30, 0), to: (-15, 0))
    retrieve $WorkOrder from $Appointment/TicketManagement.Appointment_WorkOrder;
    @position(955, 200)
    @merge(1305, 310)
    @caption 'Not new or partially planned?'
    if not($WorkOrder/Status = '_New' or 
$WorkOrder/Status = 'Partially_planned') then
      @position(1130, 200)
      @curve(from: (30, 0), to: (-15, 0))
      retrieve $PageContextList from $PlannerContext/Scheduler.PageContext_PlannerContext;
      @position(1305, 200)
      @merge(1845, 200)
      @caption 'PageContext?'
      if $PageContextList != empty then
        @position(1480, 200)
        @curve(from: (30, 0), to: (-30, 0))
        $PageContext = head $PageContextList;
        @position(1670, 200)
        change $PageContext (_ShowFooter = false);
      else
        join shared1;
      end if;
    else
      @position(1130, 310)
      change $PlannerContext (Scheduler.PlannerContext_WorkOrder_Selected = $WorkOrder);
      join shared1;
    end if;
    join shared2;
  else
    @position(610, 285)
    @anchor(to: top)
    return;
  end if;
  @position(1305, 310)
  merge shared1;
  join shared2;
  @position(1845, 200)
  merge shared2;
  @position(2020, 200)
  @curve(from: (30, 0), to: (-15, 0))
  change $PlannerContext refresh;
  @position(2170, 200)
  return;
end;

drop microflow Scheduler.SnapSetting_GetSnappedStart;
create or modify microflow Scheduler.SnapSetting_GetSnappedStart (
  @position(-285, -95)
  $CurrentStart: DateTime,
  @position(-180, -95)
  $Technician: Technician.Technician,
  @position(-180, -5)
  $SnapSetting: Scheduler.SnapSetting
)
returns DateTime
folder 'Objects/SnapSetting'
export level api
begin
  -- WARNING: the merge at (475, 300) is not represented in this description - it joins no decision and no error handler, so re-executing this MDL DELETES it. The microflow behaves the same either way (a merge with one incoming path is a no-op), but the node disappears from the diagram (mxcli #923)
  @start(-285, 200)
  @position(-175, 200)
  @curve(from: (30, 0), to: (-30, 0))
  declare $StartInterval DateTime = addMinutes($CurrentStart, -$SnapSetting/SnapPerMinutes);
  @curve(from: (30, 0), to: (-15, 0))
  declare $EndInterval DateTime = addMinutes($CurrentStart, $SnapSetting/SnapPerMinutes);
  @position(130, 200)
  @merge(475, 300)
  @caption 'stick to previous ticket?'
  if $SnapSetting/StickToPreviousTicket then
    @position(310, 200)
    @curve(from: (30, 0), to: (-15, 0))
    retrieve $Appointment_PreviousInInterval from TicketManagement.Appointment
    where [DisplayEnd >= $StartInterval]
    [DisplayEnd <= $EndInterval]
    [false()]
    sort by DisplayEnd desc
    first;
    @position(475, 200)
    @caption 'Any?'
    if $Appointment_PreviousInInterval != empty then
      @position(645, 200)
      @curve(from: (30, 0), to: (-15, 0))
      declare $AfterPreviousEnd DateTime = addMinutes($Appointment_PreviousInInterval/DisplayEnd, 1);
      @position(785, 200)
      return $AfterPreviousEnd;
    end if;
  end if;
  join shared1;
  @position(475, 300)
  merge shared1;
  @position(785, 300)
  @caption 'snap per minutes?'
  if $SnapSetting/SnapPerMinutes > 1 then
    @position(960, 300)
    @curve(from: (30, 0), to: (-15, 0))
    $RoundedDate = call microflow Scheduler.SnapSetting_RoundDate(DateTime = $CurrentStart, SnapSetting = $SnapSetting);
    @position(1080, 300)
    return $RoundedDate;
  else
    @position(785, 415)
    @anchor(to: top)
    return $CurrentStart;
  end if;
end;

drop microflow Scheduler.TechnicianRoster_GetBusyTimeslots;
create or modify microflow Scheduler.TechnicianRoster_GetBusyTimeslots (
  @position(-940, 145)
  $TechnicianRoster: RosterManagement.TechnicianRoster
)
returns List of Scheduler.Event
folder 'Objects/TechnicianRoster/Private'
begin
  @start(-940, 240)
  @position(-795, 240)
  @curve(from: (30, 0), to: (-30, 0))
  $EventList = create list of Scheduler.Event;
  @position(-605, 240)
  @curve(from: (30, 0), to: (-30, 0))
  declare $DayStart DateTime = trimToDays($TechnicianRoster/StartDate);
  @position(-415, 240)
  @curve(from: (30, 0), to: (-30, 0))
  declare $DayEnd DateTime = addDays($DayStart, 1);
  @position(-195, 240)
  @curve(from: (30, 0), to: (-30, 0))
  retrieve $AppointmentList from TicketManagement.Appointment
    where [false()]
    [(DisplayTravelStart >= $DayStart and DisplayTravelStart <= $DayEnd) or (DisplayEnd >= $DayStart and DisplayEnd <= $DayEnd)]
    sort by DisplayTravelStart asc;
  @position(200, 240)
  loop $IteratorAppointment in $AppointmentList
  begin
    @position(120, 165)
    @caption 'TravelStart & End?'
    if $IteratorAppointment/DisplayTravelStart != empty
and
$IteratorAppointment/DisplayEnd != empty then
      @position(270, 165)
      $Event_Appointment = call microflow Scheduler.Event_Create(StartDate = $IteratorAppointment/DisplayTravelStart, EndDate = $IteratorAppointment/DisplayEnd);
      @position(415, 165)
      add $Event_Appointment to $EventList;
    else
      @position(120, 280)
      @anchor(to: top)
      continue;
    end if;
  end loop;
  @position(535, 240)
  return $EventList;
end;

drop rule Scheduler.User_CanChangeAppointment;
create or modify rule Scheduler.User_CanChangeAppointment (
  @position(100, -15)
  $Appointment: TicketManagement.Appointment,
  @position(100, 70)
  $Technician: Technician.Technician
)
returns Boolean
folder 'Objects/Event'
begin
  @start(100, 200)
  @position(250, 200)
  @caption 'Can Edit all?'
  if Scheduler.User_HasPermission_EditAll() then
    @position(410, 200)
    return true;
  else
    @position(250, 330)
    @anchor(to: top)
    @curve(from: (30, 0), to: (-15, 0))
    $Technician_ForCurrentUser = call microflow Technician.Technician_Get_ForCurrentUser();
    @position(405, 330)
    @caption 'CurrentUser is Technician'
    if $Technician_ForCurrentUser != empty then
      @position(580, 330)
      @curve(from: (30, 0), to: (-15, 0))
      retrieve $Technician_Original_Mono from $Appointment/TicketManagement._Appointment_Technician;
      @position(740, 330)
      retrieve $Technician_Original from Technician.Technician
    where SystemID = $Technician_Original_Mono/SystemID
    first;
      @position(730, 330)
      @caption 'Is original Technician?'
      if $Technician_Original = $Technician_ForCurrentUser then
        @position(890, 330)
        @caption 'New Technician the same?'
        if $Technician = $Technician_ForCurrentUser then
          @position(1015, 330)
          return true;
        else
          @position(890, 435)
          @anchor(to: top)
          return false;
        end if;
      else
        @position(730, 435)
        @anchor(to: top)
        return false;
      end if;
    else
      @position(405, 435)
      @anchor(to: top)
      return false;
    end if;
  end if;
end;

drop microflow Skill.Technician_CheckWorkOrderListOnSkills;
create or modify microflow Skill.Technician_CheckWorkOrderListOnSkills (
  @position(-1110, -50)
  $WorkOrderList: List of TicketManagement.WorkOrder,
  @position(-1110, 40)
  $Technician: Technician.Technician
)
returns List of TicketManagement.WorkOrder
folder 'Objects/Skill'
begin
  @start(-1110, 200)
  @position(-970, 200)
  @curve(from: (30, 0), to: (-30, 0))
  retrieve $SkillList_Technician from $Technician/Technician.Technician_Skill;
  @position(-780, 200)
  @curve(from: (30, 0), to: (-30, 0))
  $WorkOrderList_MatchingSkills = create list of TicketManagement.WorkOrder;
  @position(-280, 200)
  loop $IteratorWorkOrder in $WorkOrderList
  begin
    @position(110, 110)
    $SkillList = call microflow DispatchSeam.WorkOrder_GetLocalSkills(WorkOrder = $IteratorWorkOrder);
    @position(275, 110)
    $HasAllSkills = contains $SkillList in $SkillList_Technician;
    @position(430, 110)
    @caption 'All skills?'
    if $HasAllSkills then
      @position(605, 110)
      add $IteratorWorkOrder to $WorkOrderList_MatchingSkills;
    else
      @position(430, 195)
      @anchor(to: top)
      continue;
    end if;
  end loop;
  @position(210, 200)
  return $WorkOrderList_MatchingSkills;
end;

drop microflow Skill.WorkOrder_CheckTechnicianListOnSkills;
create or modify microflow Skill.WorkOrder_CheckTechnicianListOnSkills (
  @position(160, 20)
  $WorkOrder: TicketManagement.WorkOrder,
  @position(160, -60)
  $TechnicianList: List of Technician.Technician
)
returns List of Technician.Technician
folder 'Objects/Skill'
begin
  @start(160, 215)
  @position(300, 215)
  @curve(from: (30, 0), to: (-30, 0))
  $TechnicianList_WithAllSkills = create list of Technician.Technician;
  @position(490, 215)
  @curve(from: (30, 0), to: (-30, 0))
  $SkillList = call microflow DispatchSeam.WorkOrder_GetLocalSkills(WorkOrder = $WorkOrder);
  @position(980, 215)
  loop $IteratorTechnician in $TechnicianList
  begin
    @position(200, 105)
    $HasAllSkills = call microflow Skill.Technician_Validate_SkillSet(Technician = $IteratorTechnician, SkillList = $SkillList);
    @position(390, 105)
    @caption 'All Skills?'
    if $HasAllSkills then
      @position(575, 105)
      add $IteratorTechnician to $TechnicianList_WithAllSkills;
    else
      @position(390, 185)
      @anchor(to: top)
      continue;
    end if;
  end loop;
  @position(1450, 215)
  return $TechnicianList_WithAllSkills;
end;

drop microflow Technician.DS_SkillRemoverHelper_Tickets_RetrieveWithoutPlannend;
create or modify microflow Technician.DS_SkillRemoverHelper_Tickets_RetrieveWithoutPlannend (
  @position(-125, 70)
  $SkillRemoveHelper: Skill.SkillRemoveHelper
)
returns List of TicketManagement.Ticket
folder 'Pages/Technician'
begin
  @start(-125, 200)
  @position(40, 200)
  $TicketList = call microflow Skill.SkillRemoveHelper_Get_TicketList_WithoutPlanned(SkillRemoveHelper = $SkillRemoveHelper);
  @position(245, 200)
  @curve(from: (30, 0), to: (-15, 0))
  $TicketList_SortedPlannedStart = sort $TicketList by PlannedWorkStart asc;
  @position(400, 200)
  return $TicketList_SortedPlannedStart;
end;

grant execute on microflow Technician.DS_SkillRemoverHelper_Tickets_RetrieveWithoutPlannend to Technician.EditAll;

drop microflow Technician.DS_SkillRemoverHelper_WorkOrders_RetrieveWithPlanned;
create or modify microflow Technician.DS_SkillRemoverHelper_WorkOrders_RetrieveWithPlanned (
  @position(-340, 55)
  $SkillRemoveHelper: Skill.SkillRemoveHelper
)
returns List of TicketManagement.Ticket
folder 'Pages/Technician'
begin
  @start(-340, 200)
  @position(-150, 200)
  $TicketList = call microflow Skill.SkillRemoveHelper_Get_WorkOrderList_WithPlanned(SkillRemoveHelper = $SkillRemoveHelper);
  @position(75, 200)
  @curve(from: (30, 0), to: (-15, 0))
  $TicketList_SortedPlannedStart = sort $TicketList by PlannedWorkStart asc;
  @position(220, 200)
  return $TicketList_SortedPlannedStart;
end;

grant execute on microflow Technician.DS_SkillRemoverHelper_WorkOrders_RetrieveWithPlanned to Technician.EditAll;

drop microflow Technician.TechnicianList_Commit_GetImpactedWorkOrders;
create or modify microflow Technician.TechnicianList_Commit_GetImpactedWorkOrders (
  @position(-215, 100)
  $TechnicianList_ToCommit: List of Technician.Technician
)
returns List of TicketManagement.WorkOrder
folder 'Objects/Technician'
begin
  @position(-55, 200)
  @curve(from: (30, 0), to: (-30, 0))
  $SkillList = call microflow Technician.TechnicianList_Commit_GetImpactedSkills(TechnicianList_ToCommit = $TechnicianList_ToCommit);
  @position(155, 200)
  @curve(from: (30, 0), to: (-30, 0))
  $SkillList_Unique = union $SkillList with $SkillList;
  @position(345, 200)
  @curve(from: (30, 0), to: (-30, 0))
  $WorkOrderList_Impacted = create list of TicketManagement.WorkOrder;
  @position(625, 200)
  loop $IteratorSkill in $SkillList_Unique
  begin
    @position(70, 100)
    retrieve $WorkOrderList from TicketManagement.WorkOrder
    where TicketManagement.WorkOrder_Skill/TicketManagement.MonoSkill/SkillName = $IteratorSkill/SkillName;
    @position(225, 100)
    add $WorkOrderList to $WorkOrderList_Impacted;
  end loop;
  @position(855, 200)
  return $WorkOrderList_Impacted;
end;

drop microflow Technician.Technician_Get_LastStartedAppointment;
create or modify microflow Technician.Technician_Get_LastStartedAppointment (
  @position(-160, 175)
  $Technician: Technician.Technician
)
returns TicketManagement.Appointment
folder 'Objects/Technician'
export level api
begin
  @start(-160, 255)
  @position(-45, 255)
  @curve(from: (30, 0), to: (-15, 0))
  retrieve $Appointment from TicketManagement.Appointment
    where [false()]
    [ActualStart != empty]
    sort by ActualStart desc
    first;
  @position(90, 255)
  return $Appointment;
end;

drop microflow Technician.Technician_Remove;
create or modify microflow Technician.Technician_Remove (
  @position(150, 85)
  $Technician: Technician.Technician
)
folder 'Objects/Technician'
export level api
begin
  @start(60, 195)
  @position(230, 195)
  @curve(from: (30, 0), to: (-30, 0))
  call microflow Technician.Technician_Set_InActive(Technician = $Technician);
  @position(400, 195)
  @curve(from: (30, 0), to: (-30, 0))
  retrieve $WorkOrderList from TicketManagement.WorkOrder
    where false();
  @position(565, 195)
  call microflow TicketManagement.WorkOrder_RemoveTechnician(WorkOrderList = $WorkOrderList, Technician = $Technician);
  @position(720, 195)
  return;
end;

drop microflow Technician.Technician_Validate_ActiveWorkOrder;
create or modify microflow Technician.Technician_Validate_ActiveWorkOrder (
  @position(-195, 60)
  $Technician: Technician.Technician
)
returns Boolean
folder 'Objects/Technician/Validations'
export level api
begin
  @start(-195, 155)
  @position(-85, 155)
  @curve(from: (30, 0), to: (-30, 0))
  declare $Valid Boolean = true;
  @position(70, 155)
  @curve(from: (30, 0), to: (-15, 0))
  retrieve $WorkOrder_Active from TicketManagement.WorkOrder
    where [false()]
    [Status != 'Finished']
    first;
  @position(215, 155)
  @caption 'No work order?'
  if $WorkOrder_Active = empty then
    @position(350, 155)
    return $Valid;
  else
    @position(215, 255)
    @anchor(from: bottom, to: top)
    @curve(from: (0, 30), to: (0, -15))
    set $Valid = false;
    @position(215, 335)
    @anchor(to: top)
    return $Valid;
  end if;
end;

drop microflow Technician.Technician_Validate_Remove;
create or modify microflow Technician.Technician_Validate_Remove (
  @position(-265, 40)
  $Technician: Technician.Technician
)
returns Utils.ValidationFeedback
folder 'Objects/Technician/Validations'
export level api
begin
  @start(-265, 130)
  @position(-110, 130)
  @curve(from: (30, 0), to: (-30, 0))
  $ValidationFeedback = call microflow Utils.ValidationFeedback_Create(ShowClientFeedback = false);
  @position(85, 130)
  @curve(from: (30, 0), to: (-15, 0))
  retrieve $Appointment_InProgress from TicketManagement.Appointment
    where [false()]
    [Status = 'In_progress' or Status = 'Traveling']
    first;
  @position(230, 130)
  @anchor(true: (to: top))
  @merge(390, 130)
  @caption 'inProgress?'
  if not($Appointment_InProgress = empty) then
    @position(230, 265)
    @anchor(to: top)
    @curve(from: (30, 0), to: (0, 15))
    call microflow Utils.ValidationFeedback_SetNotValid(ValidationFeedback = $ValidationFeedback, Message = 'You can''t remove this technician, because they have at least one work order in progress.
');
  end if;
  @position(565, 130)
  @curve(from: (30, 0), to: (-15, 0))
  retrieve $WorkOrderList_SpecificTechnician from TicketManagement.WorkOrder
    where [false()]
    [SetOnSpecificTechnician or SetOnSpecificTime];
  @position(710, 130)
  @anchor(true: (to: top))
  @merge(870, 130)
  @caption 'No pinned work orders?'
  if not($WorkOrderList_SpecificTechnician = empty) then
    @position(710, 265)
    @anchor(to: top)
    @curve(from: (30, 0), to: (0, 15))
    call microflow Utils.ValidationFeedback_SetNotValid(ValidationFeedback = $ValidationFeedback, Message = 'You can''t remove this technician because they have specific work order(s) assigned to him or to a specific time.
');
  end if;
  @position(995, 130)
  return $ValidationFeedback;
end;

drop microflow Technician.TicketList_Get_NewByTechnicianAndSkill;
create or modify microflow Technician.TicketList_Get_NewByTechnicianAndSkill (
  @position(250, 115)
  $Skill: Skill.Skill,
  @position(250, 45)
  $Technician: Technician.Technician
)
returns List of TicketManagement.Ticket
folder 'Objects/Technician'
export level api
begin
  @start(250, 200)
  @position(380, 200)
  retrieve $TicketList from TicketManagement.Ticket
    where false()
    sort by TicketID asc;
  @position(500, 200)
  return $TicketList;
end;

drop microflow Technician.Ticketlist_Get_PlannedPartiallyPlannedByTechnicianAndSkill;
create or modify microflow Technician.Ticketlist_Get_PlannedPartiallyPlannedByTechnicianAndSkill (
  @position(195, 120)
  $Skill: Skill.Skill,
  @position(195, 50)
  $Technician: Technician.Technician
)
returns List of TicketManagement.Ticket
folder 'Objects/Technician'
export level api
begin
  @start(195, 200)
  @position(310, 200)
  @curve(from: (30, 0), to: (-15, 0))
  retrieve $TicketList from TicketManagement.Ticket
    where false()
    sort by TicketID asc;
  @position(420, 200)
  return $TicketList;
end;
