drop microflow Scheduler.AvailableTimeslot_CreateAppointment;
create or modify microflow Scheduler.AvailableTimeslot_CreateAppointment (
  @position(-1495, 30)
  $PlannerContext: Scheduler.PlannerContext,
  @position(-1495, -55)
  $AvailableTimeslot: Scheduler.AvailableTimeslot
)
returns String
folder 'Objects/AvailableTimeslot'
export level api
begin
  -- WARNING: the merge at (5, 170) is not represented in this description - it joins no decision and no error handler, so re-executing this MDL DELETES it. The microflow behaves the same either way (a merge with one incoming path is a no-op), but the node disappears from the diagram (mxcli #923)
  @start(-1495, 170)
  @position(-1400, 170)
  @caption 'Work order selected?'
  if $PlannerContext/Scheduler.PlannerContext_WorkOrder_Selected != empty then
    @position(-1225, 170)
    @curve(from: (30, 0), to: (-30, 0))
    retrieve $WorkOrder from $PlannerContext/Scheduler.PlannerContext_WorkOrder_Selected;
    @position(-1035, 170)
    @curve(from: (30, 0), to: (-15, 0))
    retrieve $Technician from Technician.Technician
    where SystemID = $AvailableTimeslot/TechnicianSystemID
    first;
    @position(-890, 170)
    @caption 'Found?'
    if $Technician != empty then
      @position(-700, 170)
      @curve(from: (30, 0), to: (-15, 0))
      $SkillList = call microflow DispatchSeam.WorkOrder_GetLocalSkills(WorkOrder = $WorkOrder);
      @position(-525, 170)
      @merge(5, 170)
      @caption 'Skills needed?'
      if $SkillList != empty then
        @position(-340, 170)
        @curve(from: (30, 0), to: (-15, 0))
        $HasSkills = call microflow Skill.Technician_Validate_SkillSet(Technician = $Technician, SkillList = $SkillList);
        @position(-155, 170)
        @anchor(true: (to: top))
        @caption 'Has skills?'
        if not($HasSkills) then
          @position(-155, 345)
          @anchor(to: top)
          return empty;
        end if;
      end if;
      join shared1;
    else
      @position(-890, 275)
      @anchor(from: bottom, to: top)
      @curve(from: (0, 30), to: (0, -15))
      show message 'Cannot find any technician. Please refresh the page and try again.' type Warning blocking;
      @position(-890, 345)
      @anchor(to: top)
      return empty;
    end if;
  else
    @position(-1400, 345)
    @anchor(to: top)
    return empty;
  end if;
  @position(5, 170)
  merge shared1;
  @position(225, 170)
  @curve(to: (-15, 0))
  $IsValid = call microflow Scheduler.AvailableTimeslot_ValidateCreateAppointment(Technician = $Technician);
  @position(420, 170)
  @caption 'Valid?'
  if $IsValid then
    @position(600, 170)
    @curve(from: (30, 0), to: (-30, 0))
    $MinutesToPlan = call microflow TicketManagement.WorkOrder_GetMinutesToPlan(AvailableTimeslot = $AvailableTimeslot, WorkOrder = $WorkOrder);
    @position(840, 170)
    @curve(from: (30, 0), to: (-30, 0))
    $Appointment = call microflow Scheduler.AvailableTimeslot_CreateAppointment_ForWorkOrder(WorkOrder = $WorkOrder, AvailableTimeslot = $AvailableTimeslot, MinutesToPlan = $MinutesToPlan, Technician = $Technician);
    @position(1120, 170)
    @curve(from: (30, 0), to: (-15, 0))
    $Message = call microflow Scheduler.AvailableTimeslot_CreateAppointment_GetMessage(Appointment = $Appointment);
    @position(1290, 170)
    return $Message;
  else
    @position(420, 345)
    @anchor(to: top)
    return empty;
  end if;
end;

drop microflow Scheduler.AvailableTimeslot_CreateAppointment_GetMessage;
create or modify microflow Scheduler.AvailableTimeslot_CreateAppointment_GetMessage (
  @position(-1145, 30)
  $Appointment: TicketManagement.Appointment
)
returns String
folder 'Objects/AvailableTimeslot'
export level api
begin
  @start(-1145, 200)
  @position(-1005, 200)
  @curve(from: (30, 0), to: (-30, 0))
  declare $Message String = '';
  @position(-820, 200)
  @curve(from: (30, 0), to: (-15, 0))
  retrieve $AppointmentList_SameWO_Parent from $Appointment/TicketManagement.Appointment_WorkOrder;
    retrieve $AppointmentList_SameWO from TicketManagement.Appointment
    where [TicketManagement.Appointment_WorkOrder = $AppointmentList_SameWO_Parent]
    [id != $Appointment]
    sort by DisplayStart asc;
  @position(-645, 200)
  @merge(265, 200)
  @caption 'other appointments?'
  if $AppointmentList_SameWO != empty then
    @position(-285, 200)
    loop $IteratorAppointment in $AppointmentList_SameWO
    begin
      @position(180, 100)
      retrieve $Technician_Appointment_Mono from $IteratorAppointment/TicketManagement._Appointment_Technician;
      retrieve $Technician_Appointment from Technician.Technician
    where SystemID = $Technician_Appointment_Mono/SystemID
    first;
      @position(365, 100)
      set $Message = $Message + '
' + $Technician_Appointment/TechnicianName + ' - ' + formatDateTime($IteratorAppointment/DisplayStart) + ' - ' + formatTime($IteratorAppointment/DisplayEnd) + ' (' + $IteratorAppointment/Status + ')';
    end loop;
    @position(90, 200)
    @curve(from: (30, 0), to: (-15, 0))
    set $Message = 'This appointment has been scheduled. Under this work order the following technicians have appointments scheduled:

' + trim($Message);
  else
    @position(-645, 335)
    @anchor(to: top)
    @curve(from: (30, 0), to: (-15, 0))
    set $Message = 'This appointment has been scheduled. No other appointments exist under this workorder.';
  end if;
  @position(445, 200)
  return $Message;
end;

drop microflow Scheduler.PlannerContext_GetAppointmentList;
create or modify microflow Scheduler.PlannerContext_GetAppointmentList (
  @position(-1160, 70)
  $PlannerContext: Scheduler.PlannerContext
)
returns List of TicketManagement.Appointment
folder 'Objects/PlannerContext'
export level api
begin
  -- WARNING: the merge at (-880, 190) is not represented in this description - it joins no decision and no error handler, so re-executing this MDL DELETES it. The microflow behaves the same either way (a merge with one incoming path is a no-op), but the node disappears from the diagram (mxcli #923)
  @start(-1160, 190)
  @position(-1040, 190)
  @anchor(true: (to: top))
  @merge(-880, 190)
  @caption 'Group selected?'
  if not($PlannerContext/Scheduler.PlannerContext_TechnicianGroup != empty) then
    @position(-1040, 320)
    @anchor(to: top, true: (to: top))
    @caption 'User is SDE?'
    if not(ModuleIntegration_Administration_Impl.Rule_User_HasUserRole_SDE(User = $currentUser)) then
      @position(-1040, 450)
      @anchor(to: top)
      @caption 'User is SRM?'
      if ModuleIntegration_Administration_Impl.Rule_User_HasUserRole_SRM(User = $currentUser) then
        @position(-700, 450)
        @curve(to: (-15, 0))
        retrieve $AppointmentList_SRM from TicketManagement.Appointment
    where [DisplayStart < $PlannerContext/DataEndDate]
    [DisplayEnd > $PlannerContext/DataStartDate]
    [false()]
    sort by DisplayStart asc;
        @position(-535, 450)
        return $AppointmentList_SRM;
      @position(-1040, 580)
      @anchor(to: top)
      @caption 'User is Technician?'
      elsif ModuleIntegration_Administration_Impl.Rule_User_HasUserRole_Technician(User = $currentUser) then
        @position(-700, 580)
        @curve(to: (-15, 0))
        retrieve $AppointmentList_Tech from TicketManagement.Appointment
    where [DisplayStart < $PlannerContext/DataEndDate]
    [DisplayEnd > $PlannerContext/DataStartDate]
    [false()]
    sort by DisplayStart asc;
        @position(-535, 580)
        return $AppointmentList_Tech;
      else
        @position(-1040, 690)
        @anchor(to: top)
        return empty;
      end if;
    end if;
  end if;
  join shared1;
  @position(-880, 190)
  merge shared1;
  @position(-700, 190)
  @curve(to: (-15, 0))
  retrieve $AppointmentList from TicketManagement.Appointment
    where [DisplayStart < $PlannerContext/DataEndDate]
    [DisplayEnd > $PlannerContext/DataStartDate]
    [false()]
    sort by DisplayStart asc;
  @position(-535, 190)
  return $AppointmentList;
end;

