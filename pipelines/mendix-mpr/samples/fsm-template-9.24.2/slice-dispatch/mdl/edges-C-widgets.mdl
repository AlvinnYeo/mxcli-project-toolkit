mdl 1;
-- Legacy widgets -> React client (CE0582), generated by tools/react-widgets.py from bson dumps; DRIFT at the end.
alter page Scheduler.PageContext_View {
  replace referenceSelector3 with {
    combobox referenceSelector3 (Label: '', Association: Scheduler.PlannerContext_TechnicianGroup, DataSource: database Technician.TechnicianGroup, CaptionAttribute: Name)
  };
  replace referenceSetSelector1 with {
    dynamictext referenceSetSelector1 (Content: 'HAND-OFF: InputReferenceSetSelector')
  };
  replace dropDown1 with {
    combobox dropDown1 (Label: '', Attribute: Sorting)
  };
};
alter snippet Scheduler.Snippet_Appointment_Scheduling {
  replace grid3 with {
    datagrid grid3 (DataSource: DATABASE TicketManagement.Appointment WHERE [TicketManagement._Appointment_Technician/Technician.Technician]  SORT BY PlannedWorkStart ASC, Selection: Single) {
      column (Attribute: _Appointment_Technician/TechnicianName, Caption: 'Technician name')
      column (Attribute: PlannedWorkStart, Caption: 'Planned start date and time')
      column (Attribute: PlannedWorkEnd, Caption: 'Planned end date and time')
      column (Attribute: Appointment_WorkOrder/ShortDescription, Caption: 'Short description')
      column (Attribute: Appointment_WorkOrder/Status, Caption: 'Status')
      column (Attribute: Appointment_WorkOrder/WorkOrder_Ticket/Ticket_Priority/Description, Caption: 'Priority')
      column (Caption: ' ') {
        actionbutton actionButton14 (Caption: 'Select', Action: CALL MICROFLOW Scheduler.ACT_Appointment_Select(Appointment = $currentObject, PlannerContext = $PlannerContext))
        actionbutton actionButton9 (Caption: 'Open', Action: SHOW PAGE TicketManagement.Appointment_View(Appointment = $currentObject))
        actionbutton actionButton11 (Caption: 'Edit', Action: CALL MICROFLOW TicketManagement.ACT_Appointment_Edit(Appointment = $currentObject))
      }
    }
  };
  replace grid2 with {
    datagrid grid2 (DataSource: DATABASE TicketManagement.Appointment WHERE [TicketManagement._Appointment_Technician/Technician.Technician]                                                                                                                                         SORT BY PlannedWorkStart ASC, Selection: Single) {
      column (Attribute: _Appointment_Technician/TechnicianName, Caption: 'Technician name')
      column (Attribute: PlannedWorkStart, Caption: 'Planned start date and time')
      column (Attribute: PlannedWorkEnd, Caption: 'Planned end date and time')
      column (Attribute: Appointment_WorkOrder/ShortDescription, Caption: 'Short description')
      column (Attribute: Appointment_WorkOrder/Status, Caption: 'Status')
      column (Attribute: Appointment_WorkOrder/WorkOrder_Ticket/Ticket_Priority/Description, Caption: 'Priority')
      column (Caption: ' ') {
        actionbutton actionButton13 (Caption: 'Select', Action: CALL MICROFLOW Scheduler.ACT_Appointment_Select(Appointment = $currentObject, PlannerContext = $PlannerContext))
        actionbutton actionButton10 (Caption: 'Open', Action: SHOW PAGE TicketManagement.Appointment_View(Appointment = $currentObject))
        actionbutton actionButton12 (Caption: 'Edit', Action: CALL MICROFLOW TicketManagement.ACT_Appointment_Edit(Appointment = $currentObject))
      }
    }
  };
};
alter snippet Scheduler.Snippet_Technician_Tooltip {
  replace referenceSelector1 with {
    dataview dv_referenceSelector1 (DataSource: $Technician) {
      combobox referenceSelector1 (Label: 'Home location', Association: Technician.Technician_TechnicianLocation_Home, DataSource: database Technician.TechnicianLocation, CaptionAttribute: City)
    }
  };
  replace grid1 with {
    datagrid grid1 (DataSource: DATABASE Skill.Skill WHERE [Technician.Technician_Skill = $Technician], Selection: Single) {
      column (Attribute: SkillID, Caption: 'Skill ID')
      column (Attribute: SkillName, Caption: 'Skill name')
    }
  };
};
alter page Skill.Skill_Overview {
  replace grid1 with {
    datagrid grid1 (DataSource: DATABASE Skill.Skill SORT BY SkillID ASC, Selection: Single) {
      column (Attribute: SkillID, Caption: 'ID')
      column (Attribute: SkillName, Caption: 'Description')
      column (Caption: ' ') {
        actionbutton actionButton1 (Caption: 'Open', Action: SHOW PAGE Skill.Skill_View(Skill = $currentObject))
        actionbutton actionButton3 (Caption: 'Delete', Action: CALL MICROFLOW Skill.ACT_Skill_Delete(Skill = $currentObject))
      }
    }
  };
};
alter page Skill.Skill_Select {
  replace grid1 with {
    datagrid grid1 (DataSource: DATABASE Skill.Skill SORT BY SkillName ASC, Selection: Single) {
      column (Attribute: SkillID, Caption: 'Skill ID')
      column (Attribute: SkillName, Caption: 'Skill name')
    }
  };
};
alter page Technician.Account_Select_ServiceRegionManager {
  replace grid1 with {
    datagrid grid1 (DataSource: DATABASE Administration.Account SORT BY FullName ASC, Selection: Single) {
      column (Attribute: FullName, Caption: 'Name')
      column (Attribute: Email, Caption: 'Email')
    }
  };
};
alter page Technician.Account_Select_Technician {
  replace grid1 with {
    datagrid grid1 (DataSource: DATABASE Administration.Account SORT BY FullName ASC, Selection: Single) {
      column (Attribute: FullName, Caption: 'Full name')
      column (Attribute: Email, Caption: 'Email')
    }
  };
};
alter snippet Technician.Snippet_TechnicianGroup_Details {
  replace referenceSelector1 with {
    dataview dv_referenceSelector1 (DataSource: $TechnicianGroup) {
      combobox referenceSelector1 (Label: 'Manager', Association: Technician.TechnicianGroup_Account_Manager, DataSource: database Administration.Account, CaptionAttribute: FullName)
    }
  };
};
alter snippet Technician.Snippet_Technician_DataTabs {
  replace table2 with {
    container table2 {
      dynamictext referenceSetSelector1 (Content: 'HAND-OFF: ReferenceSetSelector')
    }
  };
  replace table3 with {
    container table3 {
      dynamictext referenceSetSelector2 (Content: 'HAND-OFF: ReferenceSetSelector')
    }
  };
  replace grid2 with {
    datagrid grid2 (DataSource: DATABASE RosterManagement.TechnicianRoster WHERE [RosterManagement.TechnicianRoster_Technician = $Technician], Selection: Multi) {
      column (Attribute: TechnicianRosterID, Caption: 'Roster ID')
      column (Attribute: StartDate, Caption: 'Start date')
      column (Attribute: EndDate, Caption: 'End date')
      column (Attribute: RosterType, Caption: 'Roster type')
      controlbar {
        actionbutton actionButton5 (Caption: 'New', Action: CALL MICROFLOW RosterManagement.ACT_TechnicianRoster_Create(Technician = $Technician))
        actionbutton actionButton6 (Caption: 'Edit', Action: CALL MICROFLOW RosterManagement.ACT_TechnicianRoster_Edit(TechnicianRosterList = $grid2))
        actionbutton deleteButton2 (Caption: 'Delete Selection', Action: CALL MICROFLOW RosterManagement.ACT_TechnicianRosterList_Delete(TechnicianRosterList = $grid2))
        actionbutton deleteButton3 (Caption: 'Delete All', Action: CALL MICROFLOW Technician.ACT_Technician_DeleteTechnicianRosters(Technician = $Technician))
        actionbutton actionButton4 (Caption: 'Create Roster For Technician', Action: CALL MICROFLOW Technician.ACT_Technician_CreateRosterCreateHelper(Technician = $Technician))
      }
    }
  };
  replace grid1 with {
    datagrid grid1 (DataSource: DATABASE TicketManagement.WorkOrder WHERE [TicketManagement.WorkOrderAssignment_WorkOrder/TicketManagement.WorkOrderAssignment [Status = 'Auto_accepted' or Status = 'Accepted' or Status = 'Pending'] /TicketManagement.WorkOrderAssignment_Technician = $Technician] SORT BY DisplayStart ASC, Selection: Single) {
      column (Attribute: WorkOrder_Ticket/Description, Caption: 'Ticket description')
      column (Attribute: WorkOrder_Ticket/CreationTime, Caption: 'Ticket Creation time')
      column (Attribute: WorkOrder_Skill/SkillName, Caption: 'Skills')
      column (Attribute: WorkOrder_Ticket/Ticket_Asset/Description, Caption: 'Asset')
      column (Attribute: WorkOrder_Ticket/Ticket_Priority/PriorityLevel, Caption: 'Priority')
      column (Attribute: Status, Caption: 'Status')
      column (Attribute: DisplayStart, Caption: 'Work start')
      column (Attribute: DisplayEnd, Caption: 'Work end')
      column (Caption: ' ') {
        actionbutton actionButton10 (Caption: 'Open', Action: SHOW PAGE TicketManagement.WorkOrder_View(WorkOrder = $currentObject))
      }
    }
  };
  replace table4 with {
    container table4 {
      datagrid grid3 (DataSource: DATABASE Technician.TechnicianGroup WHERE [Technician.TechnicianGroup_Technician = $Technician], Selection: Single) {
        column (Attribute: Name, Caption: 'Name')
        column (Attribute: TechnicianGroup_Account_Manager/FullName, Caption: 'Manager')
      }
    }
  };
};
alter snippet Technician.Snippet_Technician_Details {
  replace referenceSelector5 with {
    dataview dv_referenceSelector5 (DataSource: $Technician) {
      combobox referenceSelector5 (Label: 'Linked account', Association: Administration.Account_Technician, DataSource: database Administration.Account, CaptionAttribute: FullName)
    }
  };
  replace referenceSelector1 with {
    dataview dv_referenceSelector1 (DataSource: $Technician) {
      combobox referenceSelector1 (Label: 'Service region manager', Association: Technician.Technician_ServiceRegionManager, DataSource: database Administration.Account, CaptionAttribute: FullName)
    }
  };
};
alter page Technician.TechnicianGroup_Overview {
  replace grid1 with {
    datagrid grid1 (DataSource: DATABASE Technician.TechnicianGroup SORT BY Name ASC, Selection: Single) {
      column (Attribute: Name, Caption: 'Name')
      column (Attribute: TechnicianGroup_Account_Manager/FullName, Caption: 'Manager')
      column (Attribute: Description, Caption: 'Description')
      column (Caption: ' ') {
        actionbutton actionButton5 (Caption: 'Open', Action: CALL MICROFLOW Technician.ACT_TechnicianGroup_View(TechnicianGroup = $currentObject))
        actionbutton deleteButton1 (Caption: 'Delete', Action: CALL MICROFLOW Technician.ACT_TechnicianGroup_Delete(TechnicianGroup = $currentObject))
      }
    }
  };
};
alter page Technician.TechnicianGroup_SelectTechnician {
  replace grid2 with {
    datagrid grid2 (DataSource: DATABASE Technician.Technician WHERE [not(Technician.TechnicianGroup_Technician = $TechnicianGroup)] SORT BY TechnicianName ASC, Selection: Multi) {
      column (Attribute: TechnicianName, Caption: 'Name')
      column (Attribute: TelephoneNumber, Caption: 'Telephone number')
      column (Attribute: CompanyName, Caption: 'Company name')
      column (Attribute: Technician_Skill/SkillName, Caption: 'Skill')
      column (Attribute: IsActive, Caption: 'Active')
      controlbar {
        actionbutton actionButton1 (Caption: 'Select', Action: CALL MICROFLOW Technician.ACT_TechnicianGroup_SelectTechnician(TechnicianList = $grid2, TechnicianGroup = $TechnicianGroup))
      }
    }
  };
};
alter page Technician.TechnicianGroup_View {
  replace table2 with {
    container table2 {
      dynamictext referenceSetSelector1 (Content: 'HAND-OFF: ReferenceSetSelector')
    }
  };
};
alter page Technician.Technician_ConfirmRemove {
  replace grid4 with {
    datagrid grid4 (DataSource: DATABASE TicketManagement.WorkOrder WHERE [Status = 'In_progress'] [TicketManagement.Appointment_WorkOrder /TicketManagement.Appointment/TicketManagement.AppointmentAssignment_Appointment/TicketManagement.AppointmentAssignment /TicketManagement.AppointmentAssignment_Technician = $Technician] SORT BY DisplayStart DESC, Selection: Single) {
      column (Attribute: Description, Caption: 'Description')
      column (Attribute: WorkOrder_Ticket/CreationTime, Caption: 'Creation date')
      column (Attribute: WorkOrder_Skill/SkillName, Caption: 'Skills')
      column (Attribute: WorkOrder_Ticket/Ticket_Asset/Description, Caption: 'Asset')
      column (Attribute: WorkOrder_Ticket/Ticket_Priority/Description, Caption: 'Priority')
      column (Attribute: Status, Caption: 'Status')
      column (Attribute: DisplayStart, Caption: 'Start of work')
      column (Attribute: DisplayEnd, Caption: 'End of work')
    }
  };
  replace grid3 with {
    datagrid grid3 (DataSource: DATABASE TicketManagement.WorkOrder WHERE [Status != 'Finished'] [Status != 'In_progress'] [TicketManagement.Appointment_WorkOrder/TicketManagement.Appointment /TicketManagement.AppointmentAssignment_Appointment/TicketManagement.AppointmentAssignment /TicketManagement.AppointmentAssignment_Technician = $Technician] SORT BY DisplayStart DESC, Selection: Single) {
      column (Attribute: Description, Caption: 'Description')
      column (Attribute: WorkOrder_Skill/SkillName, Caption: 'Skills')
      column (Attribute: WorkOrder_Ticket/Ticket_Asset/Description, Caption: 'Asset')
      column (Attribute: WorkOrder_Ticket/Ticket_Priority/Description, Caption: 'Priority')
      column (Attribute: Status, Caption: 'Status')
      column (Attribute: DisplayStart, Caption: 'Start of work')
      column (Attribute: DisplayEnd, Caption: 'End of work')
      column (Attribute: SetOnSpecificTechnician, Caption: 'Specific to this technician')
      column (Attribute: SetOnSpecificTime, Caption: 'On specific time')
    }
  };
};
alter page Technician.Technician_Overview {
  replace grid1 with {
    datagrid grid1 (DataSource: DATABASE Technician.Technician SORT BY TechnicianName ASC, Selection: Multi) {
      column (Attribute: TechnicianName, Caption: 'Name')
      column (Attribute: TelephoneNumber, Caption: 'Telephone number')
      column (Attribute: EmployeeNumber, Caption: 'Employee number')
      column (Attribute: CompanyName, Caption: 'Company name')
      column (Attribute: Technician_Skill/SkillName, Caption: 'Skill')
      column (Attribute: IsActive, Caption: 'Active')
      controlbar {
        actionbutton actionButton3 (Caption: 'Create Rosters', Action: CALL MICROFLOW Technician.ACT_TechnicianList_CreateRosterCreateHelper(TechnicianList = $grid1))
        actionbutton actionButton5 (Caption: 'Open', Action: CALL MICROFLOW Technician.ACT_Technician_View(TechnicianList = $grid1))
        actionbutton deleteButton1 (Caption: 'Delete', Action: CALL MICROFLOW Technician.ACT_TechnicianList_Remove(TechnicianList = $grid1))
      }
    }
  };
};
alter page Technician.Technician_Select {
  replace grid1 with {
    datagrid grid1 (DataSource: DATABASE Technician.Technician SORT BY TechnicianName ASC, Selection: Single) {
      column (Attribute: TechnicianName, Caption: 'Name')
      column (Attribute: EmployeeNumber, Caption: 'Employee number')
      column (Attribute: CompanyName, Caption: 'Company name')
      column (Attribute: IsActive, Caption: 'Is active')
    }
  };
};
alter page Technician.Technician_SelectSkill {
  replace grid1 with {
    datagrid grid1 (DataSource: DATABASE Skill.Skill WHERE [not(Technician.Technician_Skill = $Technician)] SORT BY SkillName ASC, Selection: Multi) {
      column (Attribute: SkillName, Caption: 'Name')
      controlbar {
        actionbutton actionButton1 (Caption: 'Select', Action: CALL MICROFLOW Technician.ACT_Technician_SelectSkill(SkillList = $grid1, Technician = $Technician))
      }
    }
  };
};
alter page Technician.Technician_SelectWarehouse {
  replace grid1 with {
    datagrid grid1 (DataSource: DATABASE WarehouseManagement.Warehouse WHERE [not(Technician.Technician_Warehouse = $Technician)] SORT BY Description ASC, Selection: Multi) {
      column (Attribute: Description, Caption: 'Description')
      controlbar {
        actionbutton actionButton1 (Caption: 'Select', Action: CALL MICROFLOW Technician.ACT_Technician_SelectWarehouse(WarehouseList = $grid1, Technician = $Technician))
      }
    }
  };
};
alter page Technician.Technician_Skill_Remove {
  replace grid5 with {
    datagrid grid5 (DataSource: MICROFLOW Technician.DS_SkillRemoverHelper_Tickets_RetrieveWithoutPlannend(SkillRemoveHelper = $SkillRemoveHelper), Selection: Single) {
      column (Attribute: TicketID, Caption: 'Ticket ID')
      column (Attribute: Description, Caption: 'Description')
      column (Attribute: PlannedWorkStart, Caption: 'Planned Start')
      column (Attribute: PlannedWorkEnd, Caption: 'Planned End')
    }
  };
  replace grid4 with {
    datagrid grid4 (DataSource: MICROFLOW Technician.DS_SkillRemoverHelper_WorkOrders_RetrieveWithPlanned(SkillRemoveHelper = $SkillRemoveHelper), Selection: Single) {
      column (Attribute: TicketID, Caption: 'Ticket ID')
      column (Attribute: Description, Caption: 'Description')
      column (Attribute: PlannedWorkStart, Caption: 'Planned Start')
      column (Attribute: PlannedWorkEnd, Caption: 'Planned End')
    }
  };
};
alter page TimeRegistration.RegistrationCode_Overview {
  replace grid1 with {
    datagrid grid1 (DataSource: DATABASE TimeRegistration.RegistrationCode SORT BY Code ASC, Selection: Single) {
      column (Attribute: CodeType, Caption: 'Type')
      column (Attribute: Code, Caption: 'Code')
      column (Attribute: SubCode, Caption: 'Sub code')
      column (Attribute: IsDefault, Caption: 'Default code')
      column (Attribute: Description, Caption: 'Description')
      column (Caption: ' ') {
        actionbutton actionButton1 (Caption: 'Open', Action: SHOW PAGE TimeRegistration.RegistrationCode_View(RegistrationCode = $currentObject))
        actionbutton actionButton3 (Caption: 'Delete', Action: CALL MICROFLOW TimeRegistration.ACT_RegistrationCode_Delete(RegistrationCode = $currentObject))
      }
    }
  };
};
alter snippet TimeRegistration.Snippet_RegistrationCode_Details {
  replace dropDown1 with {
    dataview dv_dropDown1 (DataSource: $RegistrationCode) {
      combobox dropDown1 (Label: 'Type', Attribute: CodeType)
    }
  };
  replace dropDown2 with {
    dataview dv_dropDown2 (DataSource: $RegistrationCode) {
      combobox dropDown2 (Label: 'Registration type *', Attribute: RegistrationType)
    }
  };
};
