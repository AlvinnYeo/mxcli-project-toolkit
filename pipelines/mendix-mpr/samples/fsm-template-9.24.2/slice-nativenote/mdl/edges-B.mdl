);

grant read (PublicThumbnailPath, FileID, Name, DeleteAfterDownload, Contents, HasContents, Size) on entity Synchronization.NoteImage to Synchronization.ViewAll;

grant create, read (PublicThumbnailPath, FileID, HasContents, Size, HasBeenUploaded, Name, DeleteAfterDownload, Contents), write (HasBeenUploaded, Name, DeleteAfterDownload, Contents) on entity Synchronization.NoteImage to Synchronization.CreateMy where [System.owner='[%CurrentUser%]'][HasBeenUploaded = false()];
@anchor(from: (0, 100), to: (0, 0))
create or modify association Synchronization.OfflineImageAction_NoteImage
from Synchronization.OfflineImageAction to Synchronization.NoteImage
storage table;

grant create, read (ProcessedDate, NeedsReview, ReviewMessage, ImageAction, NoteID, ObjectID, CreatedDateTime, HasBeenUploaded, OfflineImageAction_NoteImage), write (ImageAction, NoteID, ObjectID, CreatedDateTime, HasBeenUploaded, OfflineImageAction_NoteImage) on entity Synchronization.OfflineImageAction to Synchronization.CreateMy where [System.owner='[%CurrentUser%]'][HasBeenUploaded = false()];

grant read (ImageAction, NoteID, ObjectID, CreatedDateTime, ProcessedDate, NeedsReview, ReviewMessage, OfflineImageAction_NoteImage) on entity Synchronization.OfflineImageAction to Synchronization.ViewAll;
create or modify microflow Synchronization.ACO_OfflineAction_SetHasBeenUploadedTrue (
  @position(100, 90)
  $OfflineAction: Synchronization.OfflineAction
)
folder 'Objects/OfflineAction'
begin
  @start(100, 200)
  @position(195, 200)
  @curve(from: (15, 0), to: (-30, 0))
  @caption 'Has been uploaded false?'
  if $OfflineAction/HasBeenUploaded = false then
    @position(390, 200)
    @curve(from: (30, 0), to: (-15, 0))
    change $OfflineAction (HasBeenUploaded = true) commit without events;
    @position(520, 200)
    return;
  else
    @position(195, 290)
    @anchor(to: top)
    return;
  end if;
end;
