  @position(200, 55)
  $OfflineActionList: List of Synchronization.OfflineAction
)
folder 'Objects/OfflineAction'
begin
  @start(195, 200)
  @position(395, 200)
  commit $OfflineActionList refresh;
  @position(615, 200)
  return;
end;
create or modify nanoflow Synchronization.OfflineActionList_Save_NF (
