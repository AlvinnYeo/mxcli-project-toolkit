create or modify nanoflow Synchronization.OfflineImageAction_Create (
  @position(-255, -30)
  $NativeImage: NativeNote.NativeImage,
  @position(-255, 80)
  $ENUM_ImageAction: enum NativeNote.ENUM_ImageAction,
  @position(-255, -140)
  $NativeNote: NativeNote.NativeNote
)
returns Synchronization.OfflineImageAction
folder 'Objects/OfflineImageAction/Private'
begin
  @position(-95, 200)
  @curve(from: (30, 0), to: (-30, 0))
  $NewNoteImage = create Synchronization.NoteImage refresh;
  @position(95, 200)
  @curve(from: (30, 0), to: (-30, 0))
  $ReturnValueName = call javascript action Synchronization.JS_CloneFileDocument(SourceFileDocument = $NativeImage, TargetFileDocument = $NewNoteImage);
  @position(270, 200)
  @curve(from: (30, 0), to: (-30, 0))
  change $NewNoteImage (Name = $NativeImage/Name) refresh;
  @position(475, 200)
  @curve(from: (30, 0), to: (-15, 0))
  $NewOfflineImageAction = create Synchronization.OfflineImageAction (ObjectID = $NativeImage/SystemID, ImageAction = $ENUM_ImageAction, NoteID = $NativeNote/SystemID, CreatedDateTime = [%CurrentDateTime%], OfflineImageAction_NoteImage = $NewNoteImage) refresh;
  @position(805, 200)
  return $NewOfflineImageAction;
end;
create or modify nanoflow Synchronization.NoteImage_Commit (
  @position(-30, 85)
  $OfflineImageAction: Synchronization.OfflineImageAction
)
folder 'Objects/NoteImage'
begin
  @start(-30, 200)
  @position(110, 200)
  @curve(from: (30, 0), to: (-30, 0))
  retrieve $NoteImage from $OfflineImageAction/Synchronization.OfflineImageAction_NoteImage;
  @position(300, 200)
  commit $NoteImage refresh;
  @position(490, 200)
  return;
end;
create or modify nanoflow Synchronization.NativeImage_SetupOfflineImageAction (
  @position(-210, -65)
  $NativeImage: NativeNote.NativeImage,
  @position(-210, 30)
  $ENUM_ImageAction: enum NativeNote.ENUM_ImageAction
)
folder 'Objects/OfflineImageAction'
begin
  @start(-210, 200)
  @position(-70, 200)
  @curve(from: (30, 0), to: (-30, 0))
  retrieve $NativeNote from $NativeImage/NativeNote.NativeImage_NativeNote;
  @position(155, 200)
  @curve(from: (30, 0), to: (-30, 0))
  $OfflineImageAction = call nanoflow Synchronization.OfflineImageAction_Create(NativeImage = $NativeImage, ENUM_ImageAction = $ENUM_ImageAction, NativeNote = $NativeNote);
  @position(390, 200)
  @curve(from: (30, 0), to: (-30, 0))
  call nanoflow Synchronization.NoteImage_Commit(OfflineImageAction = $OfflineImageAction);
  @position(580, 200)
  @curve(from: (30, 0), to: (-15, 0))
  call nanoflow Synchronization.OfflineAction_Save(OfflineAction = $OfflineImageAction);
  @position(720, 200)
  return;
end;

create or modify nanoflow Synchronization.NativeNote_SetupOfflineImageActions (
  @position(60, 55)
  $NativeNote: NativeNote.NativeNote
)
folder 'Objects/OfflineImageAction'
begin
  @start(60, 200)
  @position(185, 200)
  @curve(to: (-15, 0))
  retrieve $NativeImageList from $NativeNote/NativeNote.NativeImage_NativeNote;
  @position(360, 200)
  @curve(from: (15, 0), to: (-30, 0))
  @caption 'ImageList?'
  if $NativeImageList != empty then
    @position(850, 200)
    @curve(from: (30, 0), to: (-15, 0))
    loop $IteratorNativeImage in $NativeImageList
    begin
      @position(255, 100)
      @curve(from: (30, 0), to: (-30, 0))
      call nanoflow Synchronization.NativeImage_SetupOfflineImageAction(NativeImage = $IteratorNativeImage, ENUM_ImageAction = NativeNote.ENUM_ImageAction.Add_Image);
      @position(530, 100)
      change $IteratorNativeImage (IsSaved = true) refresh;
    end loop;
    @position(1285, 200)
    return;
  else
    @position(360, 340)
    @anchor(to: top)
    return;
  end if;
end;

-- cycle break: entity <-> its after-commit microflow. Created without the handler above, re-applied with it here.
@Position(250, 10)
create or modify persistent entity Synchronization.OfflineAction (
  ObjectID: String(200),
  CreatedDateTime: DateTime,
  ProcessedDate: DateTime,
  NeedsReview: Boolean default false,
  ReviewMessage: String(unlimited),
  HasBeenUploaded: Boolean default false,
  Owner: AutoOwner,
  ChangedDate: AutoChangedDate
)
on after commit call Synchronization.ACO_OfflineAction_SetHasBeenUploadedTrue($currentObject);
@Position(490, 1690)
create or modify persistent entity Synchronization.NoteImage extends System.Image (
  HasBeenUploaded: Boolean default false
)
on after commit call Synchronization.ACO_NoteImage_SetHasBeenUploadedTrue($currentObject);

