grant view on page CoreSeam.TechnicianLink_Edit to CoreSeam.Admin;

alter snippet WarehouseManagement.Snippet_Warehouse_DataTabs {
  replace grid2 with {
      datagrid grid2 (
        DataSource: database from CoreSeam.TechnicianLink where [CoreSeam.TechnicianLink_Warehouse = $Warehouse] sort by TechnicianName asc,
        Selection: Single
      ) {
        controlbar {
          actionbutton btnAddTechnician (
            Caption: 'Add technician',
            Action: call microflow CoreSeam.ACT_Warehouse_AddTechnician(Warehouse = $Warehouse)
          )
        }
        column (Attribute: TechnicianName, Caption: 'Name')
        column (Attribute: TelephoneNumber, Caption: 'Telephone number')
        column (Attribute: EmployeeNumber, Caption: 'Employee number')
        column (Attribute: CompanyName, Caption: 'Company name')
        column (Caption: ' ', ShowContentAs: customContent) {
          actionbutton btnEditLink (Caption: 'Account', Action: show page CoreSeam.TechnicianLink_Edit(TechnicianLink = $currentObject))
          actionbutton btnDeleteLink (Caption: 'Remove', Action: call microflow CoreSeam.ACT_TechnicianLink_Delete(TechnicianLink = $currentObject))
        }
      }
  };
};

-- ---------------------------------------------------------------- selectable tools without XPath over local -> external
-- FSM retrieved Tool where SelectedTool_Tool/SelectedTool/SelectedTool_WorkOrder = $WorkOrder: an XPath from local
-- entities into an external one (CE0161 on 11.13). Same result in memory: the work order's selected tools by
-- list filter on the association. Reads every SelectedTool row: fine at template scale, a hand-off at volume.
drop microflow Tool.SelectedTool_GetSelectableToolList;
create or modify microflow Tool.SelectedTool_GetSelectableToolList (
  $SelectedTool: Tool.SelectedTool
)
returns List of Tool.Tool
folder 'Objects/SelectedTool'
export level api
begin
  retrieve $ToolList_Active from Tool.Tool where [IsActive];
  retrieve $WorkOrder from $SelectedTool/Tool.SelectedTool_WorkOrder;
  retrieve $AllSelected from Tool.SelectedTool;
  $SelectedOnWorkOrder = filter $AllSelected by Tool.SelectedTool_WorkOrder = $WorkOrder;
  $ToolList_AlreadySelected = create list of Tool.Tool;
  loop $IteratorSelected in $SelectedOnWorkOrder
  begin
    retrieve $SelectedToolTool from $IteratorSelected/Tool.SelectedTool_Tool;
    add $SelectedToolTool to $ToolList_AlreadySelected;
  end loop;
  $ToolList_Selectable = subtract $ToolList_AlreadySelected from $ToolList_Active;
  return $ToolList_Selectable;
end;

-- ---------------------------------------------------------------- roles: the seam module roles reach real user roles
alter user role CallCenterEmployee add module roles (CoreSeam.User, Technician.User);
alter user role FunctionalAdministrator add module roles (CoreSeam.User, CoreSeam.Admin, Technician.User);
alter user role Mechanic add module roles (CoreSeam.User, Technician.User);
alter user role ServiceDeskEmployee add module roles (CoreSeam.User, Technician.User);
alter user role ServiceRegionManager add module roles (CoreSeam.User, Technician.User);
alter user role TechnicalAdministrator add module roles (CoreSeam.User, CoreSeam.Admin, Technician.User);
alter user role Administrator add module roles (CoreSeam.User, CoreSeam.Admin, Technician.User);
