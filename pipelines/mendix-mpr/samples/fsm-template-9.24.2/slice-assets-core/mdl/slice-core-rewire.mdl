-- ---------------------------------------------------------------- asset tabs: grids over external data
alter snippet AssetManagement.Snippet_Asset_DataTabs {
  replace grid2 with {
      datagrid grid2 (
        DataSource: database from TicketManagement.ContactPerson where [TicketManagement.ContactPerson_Asset/TicketManagement.MonoAsset/SystemID = $Asset/SystemID] sort by Name asc,
        Selection: Single
      ) {
        column (Attribute: Name, Caption: 'Name')
        column (Attribute: PhoneNumber, Caption: 'Phone number')
        column (Attribute: EmailAddress, Caption: 'Email')
        column (Attribute: Description, Caption: 'Job description')
        column (Attribute: ContactPerson_Customer/CustomerName, Caption: 'Customer(s)')
        column (Attribute: ContactPerson_Contract/Number, Caption: 'Contract(s)')
        column (Caption: ' ', ShowContentAs: customContent) {
          actionbutton actionButton2 (
            Caption: 'Open',
            Action: show page CustomerManagement.ContactPerson_View(ContactPerson = $currentObject)
          )
        }
      }
  };
  replace grid3 with {
      datagrid grid3 (
        DataSource: database from TicketManagement.Roster where [TicketManagement.Roster_Asset/TicketManagement.MonoAsset/SystemID = $Asset/SystemID] sort by StartDate asc,
        Selection: Single
      ) {
        controlbar {
          actionbutton actionButton3 (
            Caption: 'New',
            Action: call microflow AssetManagement.ACT_Asset_CreateRoster(Asset = $Asset)
          )
          actionbutton deleteButton3 (
            Caption: 'Delete All',
            Action: call microflow AssetManagement.ACT_Asset_DeleteRosters(Asset = $Asset)
          )
        }
        column (Attribute: StartDate, Caption: 'Start date')
        column (Attribute: EndDate, Caption: 'End date')
        column (Attribute: StartTime, Caption: 'Start time')
        column (Attribute: EndTime, Caption: 'End time')
        column (Caption: ' ', ShowContentAs: customContent) {
          actionbutton editButton2 (
            Caption: 'View',
            Action: show page RosterManagement.Roster_NewEdit(Roster = $currentObject)
          )
          actionbutton deleteButton2 (
            Caption: 'Delete',
            Action: call microflow RosterManagement.ACT_Roster_Delete(Roster = $currentObject)
          )
        }
      }
  };
  replace grid1 with {
      datagrid grid1 (
        DataSource: database from TicketManagement.Ticket where [TicketManagement.Ticket_Asset/TicketManagement.MonoAsset/SystemID = $Asset/SystemID] sort by CreationTime desc,
        Selection: Single
      ) {
        column (Attribute: TicketID, Caption: 'Ticket ID')
        column (Attribute: CreationTime, Caption: 'Creation date')
        column (Attribute: Description, Caption: 'Description')
        column (Attribute: Ticket_TicketType/Name, Caption: 'Type')
        column (Attribute: Ticket_Priority/Description, Caption: 'Priority')
        column (Attribute: Status, Caption: 'Status')
        column (Caption: ' ', ShowContentAs: customContent) {
          actionbutton actionButton6 (
            Caption: 'Open',
            Action: show page TicketManagement.Ticket_View(Ticket = $currentObject)
          )
        }
      }
  };
};

-- ---------------------------------------------------------------- warehouse technicians: pick from the monolith
create or modify microflow CoreSeam.ACT_Warehouse_LinkTechnician (
  $Warehouse: WarehouseManagement.Warehouse,
  $Technician: Technician.Technician
)
begin
  retrieve $Existing from CoreSeam.TechnicianLink where [TechnicianID = $Technician/TechnicianID and CoreSeam.TechnicianLink_Warehouse = $Warehouse] first;
  if $Existing = empty then
    $Link = create CoreSeam.TechnicianLink (TechnicianID = $Technician/TechnicianID, TechnicianLink_Warehouse = $Warehouse, TechnicianLink_Technician = $Technician);
    change $Link (TechnicianName = $Technician/TechnicianName, TelephoneNumber = $Technician/TelephoneNumber, EmployeeNumber = $Technician/EmployeeNumber, CompanyName = $Technician/CompanyName);
    commit $Link;
  end if;
  close page;
  return;
end;
grant execute on microflow CoreSeam.ACT_Warehouse_LinkTechnician to CoreSeam.Admin;

create or modify page CoreSeam.Technician_Select (
  Title: 'Add technician (from FSM)',
  Layout: Atlas_Core.PopupLayout,
  Params: ( $Warehouse: WarehouseManagement.Warehouse )
) {
  datagrid gridTechSelect (
    DataSource: database from Technician.Technician where [IsActive = true()] sort by TechnicianName asc,
    Selection: Single
  ) {
    column (Attribute: TechnicianName, Caption: 'Name')
    column (Attribute: EmployeeNumber, Caption: 'Employee number')
    column (Attribute: CompanyName, Caption: 'Company name')
    column (Caption: ' ', ShowContentAs: customContent) {
      actionbutton btnLinkTech (
        Caption: 'Add',
        Action: call microflow CoreSeam.ACT_Warehouse_LinkTechnician(Warehouse = $Warehouse, Technician = $currentObject)
      )
    }
  }
};
grant view on page CoreSeam.Technician_Select to CoreSeam.Admin;

create or modify microflow CoreSeam.ACT_Warehouse_AddTechnician (
  $Warehouse: WarehouseManagement.Warehouse
)
begin
  show page CoreSeam.Technician_Select(Warehouse = $Warehouse);
  return;
end;
grant execute on microflow CoreSeam.ACT_Warehouse_AddTechnician to CoreSeam.Admin;

create or modify microflow CoreSeam.ACT_TechnicianLink_Delete (
  $TechnicianLink: CoreSeam.TechnicianLink
)
begin
  delete $TechnicianLink refresh;
  return;
end;
grant execute on microflow CoreSeam.ACT_TechnicianLink_Delete to CoreSeam.Admin;

create or modify page CoreSeam.TechnicianLink_Edit (
  Title: 'Technician account',
  Layout: Atlas_Core.PopupLayout,
