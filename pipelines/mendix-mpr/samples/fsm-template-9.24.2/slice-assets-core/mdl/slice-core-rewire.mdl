mdl 1;
-- Increment 6, slice: re-point every consumer of the former stubs at the monolith's core.
--  * reads    -> external entities (OData), XPath only over attributes or over associations BETWEEN external
--                entities of the same service (Ticket_Asset -> MonoAsset/SystemID), never local <-> external.
--  * writes   -> the monolith's published REST actions (rosters), on error without rollback + log + message.
--  * Account_Technician (a stub association added to the Marketplace Administration module) -> local owner
--    entity CoreSeam.TechnicianLink: Account, Warehouse and the external Technician hang off it, all owned locally.

create or modify module role Technician.User description 'reads monolith technicians (external entity)';
-- ---------------------------------------------------------------- technician link (local owner entity)
create or modify persistent entity CoreSeam.TechnicianLink (
  TechnicianID: Long,
  TechnicianName: String(200),
  TelephoneNumber: String(200),
  EmployeeNumber: String(200),
  CompanyName: String(200)
);
create or modify association CoreSeam.TechnicianLink_Account from CoreSeam.TechnicianLink to Administration.Account storage table;
create or modify association CoreSeam.TechnicianLink_Warehouse from CoreSeam.TechnicianLink to WarehouseManagement.Warehouse storage table on delete cascade;
create or modify association CoreSeam.TechnicianLink_Technician from CoreSeam.TechnicianLink to Technician.Technician storage table;
create or modify module role CoreSeam.Admin description 'links monolith technicians to slice warehouses and accounts';
grant create, delete, read (TechnicianID, TechnicianName, TelephoneNumber, EmployeeNumber, CompanyName, TechnicianLink_Account, TechnicianLink_Warehouse, TechnicianLink_Technician), write (TechnicianID, TechnicianName, TelephoneNumber, EmployeeNumber, CompanyName, TechnicianLink_Account, TechnicianLink_Warehouse, TechnicianLink_Technician) on entity CoreSeam.TechnicianLink to CoreSeam.Admin;
grant read (TechnicianID, TechnicianName, TelephoneNumber, EmployeeNumber, CompanyName, TechnicianLink_Account, TechnicianLink_Warehouse, TechnicianLink_Technician) on entity CoreSeam.TechnicianLink to CoreSeam.User;

grant read (SystemID, AssetID, "Description") on entity TicketManagement.MonoAsset to TicketManagement.User;
-- read access on the external entities (replaces the stub-module read grants of increment 5)
grant read (TechnicianID, TechnicianName, TelephoneNumber, EmailAddress, EmployeeNumber, CompanyName, IsActive, IsExternal) on entity Technician.Technician to Technician.User;
grant read (PublicID, CustomerID, DebtorNumber, CustomerName, Email, PhoneNumber, ReferenceNumber) on entity TicketManagement.Customer to TicketManagement.User;
grant read (PublicID, Number, "Description", AdministrativeContactPersonName, AdministrativeEmailAddress) on entity TicketManagement.Contract to TicketManagement.User;
grant read (PublicID, Name, PhoneNumber, EmailAddress, "Description", ContactPerson_Asset, ContactPerson_Customer, ContactPerson_Contract) on entity TicketManagement.ContactPerson to TicketManagement.User;
grant read (PublicID, Number, "Description", SLAtype, HighPriorityResponseTime, MediumPriorityResponseTime, LowPriorityResponseTime, SLA_Asset, SLA_Contract, SLA_Customer, SLA_UmbrellaContract) on entity TicketManagement.SLA to TicketManagement.User;
grant read (PublicID, TicketID, "Status", ShortDescription, "Description", CallerName, CreationTime, DueDate, Ticket_Asset, Ticket_Priority, Ticket_TicketType) on entity TicketManagement.Ticket to TicketManagement.User;
grant read (PublicID, Code, "Description", IsActive) on entity TicketManagement.Priority to TicketManagement.User;
grant read (PublicID, Code, Name, ExpectedDuration) on entity TicketManagement.TicketType to TicketManagement.User;
grant read (PublicID, WorkOrderID, "Status", ShortDescription, DueDate, WorkOrder_Ticket) on entity TicketManagement.WorkOrder to TicketManagement.User;
grant read (PublicID, AppointmentID, "Status", PlannedWorkStart, PlannedWorkEnd, Appointment_WorkOrder) on entity TicketManagement.Appointment to TicketManagement.User;
grant read (PublicID, StartDate, EndDate, StartTime, EndTime, Monday, Tuesday, Wednesday, Thursday, Friday, Saturday, Sunday, Roster_Asset) on entity TicketManagement.Roster to TicketManagement.User;

-- "My" access rules: the warehouse disjunct now runs over the local TechnicianLink. The work-order disjuncts
-- (WorkOrderAssignment_Technician / _WorkOrder, Appointment_WorkOrder) would have to traverse local -> external
-- associations in XPath, which external entities do not support; they are replaced by false() and stay hand-off
-- rows: a mechanic's work-order parts and tools are the Mobile partition's / monolith's concern.
revoke all on entity Part.Part from Part.ViewMy;
grant read (PartID, SystemID, Name, "Description", Price, IsAdditionalPart, IsActive, Vendor, Part_UnitOfMeasure) on entity Part.Part to Part.ViewMy where [WarehouseManagement.Inventory_Part/WarehouseManagement.Inventory/WarehouseManagement.Inventory_Warehouse/WarehouseManagement.Warehouse/CoreSeam.TechnicianLink_Warehouse/CoreSeam.TechnicianLink/CoreSeam.TechnicianLink_Account = '[%CurrentUser%]'];
revoke all on entity Part.SuggestedPart from Part.ViewMy;
grant read (Quantity, SystemID, SuggestedPart_Part, SuggestedPart_WorkOrder) on entity Part.SuggestedPart to Part.ViewMy where [false()];
revoke all on entity Part.UsedPart from Part.ViewMy;
grant read (IsFromWarehouse, Quantity, SystemID, UsedPart_Inventory) on entity Part.UsedPart to Part.ViewMy where [false()];
revoke all on entity Tool.SelectedTool from Tool.ViewMy;
grant read (SelectedToolID, Quantity, SelectedTool_Tool, SelectedTool_WorkOrder) on entity Tool.SelectedTool to Tool.ViewMy where [false()];
revoke all on entity Tool.Tool from Tool.ViewMy;
grant read (ToolID, Name, "Description", IsActive) on entity Tool.Tool to Tool.ViewMy where [false()];
revoke all on entity WarehouseManagement.Inventory from WarehouseManagement.ViewMy;
grant read (InventoryID, SystemID, Amount, Inventory_Warehouse, Inventory_Part) on entity WarehouseManagement.Inventory to WarehouseManagement.ViewMy where [WarehouseManagement.Inventory_Warehouse/WarehouseManagement.Warehouse/CoreSeam.TechnicianLink_Warehouse/CoreSeam.TechnicianLink/CoreSeam.TechnicianLink_Account = '[%CurrentUser%]'];
revoke all on entity WarehouseManagement.Warehouse from WarehouseManagement.ViewMy;
grant read (WarehouseID, SystemID, "Description") on entity WarehouseManagement.Warehouse to WarehouseManagement.ViewMy where [CoreSeam.TechnicianLink_Warehouse/CoreSeam.TechnicianLink/CoreSeam.TechnicianLink_Account = '[%CurrentUser%]'];

-- ---------------------------------------------------------------- roster writes over REST
create or modify non-persistent entity CoreSeam.RosterDraft (
  StartDate: DateTime,
  EndDate: DateTime
);
create or modify association CoreSeam.RosterDraft_Asset from CoreSeam.RosterDraft to AssetManagement.Asset;
grant create, delete, read (StartDate, EndDate, RosterDraft_Asset), write (StartDate, EndDate, RosterDraft_Asset) on entity CoreSeam.RosterDraft to CoreSeam.User;

create or modify microflow CoreSeam.Roster_CreateRemote (
  $Asset: AssetManagement.Asset,
  $StartDate: DateTime,
  $EndDate: DateTime
) returns Boolean
begin
  $Response = call rest service post '{1}/rest/core/v1/rosters?AssetSystemID={2}&AssetID={3}&AssetDescription={4}&StartDate={5}&EndDate={6}' with (
    {1} = @CoreSeam.CoreBaseUrl,
    {2} = urlEncode($Asset/SystemID),
    {3} = urlEncode(if $Asset/AssetID = empty then '' else $Asset/AssetID),
    {4} = urlEncode(if $Asset/Description = empty then '' else $Asset/Description),
    {5} = formatDateTime($StartDate, 'yyyy-MM-dd'),
    {6} = formatDateTime($EndDate, 'yyyy-MM-dd')
  ) (
    Authentication: basic (Username: @CoreSeam.CoreAPIUserName, Password: @CoreSeam.CoreAPIPassword),
    Timeout: 30,
  ) returns String on error without rollback begin
    log error node 'CoreSeam' 'monolith roster create for asset {1} failed: {2}' with ({1} = $Asset/SystemID, {2} = $latestError/Message);
    return false;
  end error;
  log info node 'CoreSeam' 'monolith roster create for asset {1}: {2}' with ({1} = $Asset/SystemID, {2} = $Response);
  return true;
end;

create or modify microflow CoreSeam.Rosters_DeleteRemoteForAsset (
  $Asset: AssetManagement.Asset
) returns Boolean
begin
  $Response = call rest service post '{1}/rest/core/v1/rosters/delete-for-asset?AssetSystemID={2}' with (
    {1} = @CoreSeam.CoreBaseUrl,
    {2} = urlEncode($Asset/SystemID)
  ) (
    Authentication: basic (Username: @CoreSeam.CoreAPIUserName, Password: @CoreSeam.CoreAPIPassword),
    Timeout: 30,
  ) returns String on error without rollback begin
    log error node 'CoreSeam' 'monolith roster delete for asset {1} failed: {2}' with ({1} = $Asset/SystemID, {2} = $latestError/Message);
    return false;
  end error;
  log info node 'CoreSeam' 'monolith roster delete for asset {1}: {2}' with ({1} = $Asset/SystemID, {2} = $Response);
  return true;
end;

create or modify microflow CoreSeam.ACT_RosterDraft_Save (
  $RosterDraft: CoreSeam.RosterDraft
)
begin
  retrieve $Asset from $RosterDraft/CoreSeam.RosterDraft_Asset;
  if $RosterDraft/StartDate = empty or $RosterDraft/EndDate = empty then
    validation feedback $RosterDraft/StartDate message 'Start and end date are required';
    return;
  end if;
  $Ok = call microflow CoreSeam.Roster_CreateRemote(Asset = $Asset, StartDate = $RosterDraft/StartDate, EndDate = $RosterDraft/EndDate);
  if $Ok then
    close page;
    return;
  else
    show message 'The planner (FSM) could not be reached; the opening times were not saved. Try again later.' type Error blocking;
    return;
  end if;
end;
grant execute on microflow CoreSeam.ACT_RosterDraft_Save to CoreSeam.User;

create or modify page CoreSeam.RosterDraft_New (
  Title: 'New opening times',
  Layout: Atlas_Core.PopupLayout,
  Params: ( $RosterDraft: CoreSeam.RosterDraft )
) {
  dataview dvDraft (DataSource: $RosterDraft) {
    datepicker dpStart (Label: 'Start date', Attribute: StartDate)
    datepicker dpEnd (Label: 'End date', Attribute: EndDate)
    footer {
      actionbutton btnSaveDraft (Caption: 'Save', Action: call microflow CoreSeam.ACT_RosterDraft_Save(RosterDraft = $RosterDraft), ButtonStyle: Primary)
      actionbutton btnCancelDraft (Caption: 'Cancel', Action: cancel changes)
    }
  }
};
grant view on page CoreSeam.RosterDraft_New to CoreSeam.User;

-- FSM's Asset_CreateRoster returned a new Roster for Roster_NewEdit; the slice cannot create an external object,
-- so it returns a draft and the monolith creates the roster when the draft is saved.
drop microflow AssetManagement.ACT_Asset_CreateRoster;
create or modify microflow AssetManagement.ACT_Asset_CreateRoster (
  $Asset: AssetManagement.Asset
)
folder 'Pages/Asset'
begin
  $Draft = create CoreSeam.RosterDraft (RosterDraft_Asset = $Asset, StartDate = beginOfDay([%CurrentDateTime%]), EndDate = addDays(beginOfDay([%CurrentDateTime%]), 30));
  show page CoreSeam.RosterDraft_New(RosterDraft = $Draft) with title = 'New opening times';
  return;
end;
grant execute on microflow AssetManagement.ACT_Asset_CreateRoster to AssetManagement._AddOn_CreateAssetRosters;

drop microflow AssetManagement.Asset_CreateRoster;

drop microflow AssetManagement.Asset_DeleteRosters;
create or modify microflow AssetManagement.Asset_DeleteRosters (
  $Asset: AssetManagement.Asset
)
folder 'Objects/Asset'
export level api
begin
  $Ok = call microflow CoreSeam.Rosters_DeleteRemoteForAsset(Asset = $Asset);
  call microflow Synchronization.Asset_UpdateNativeAsset(Asset = $Asset);
  return;
end;

drop microflow RosterManagement.ACT_Roster_Delete;
create or modify microflow RosterManagement.ACT_Roster_Delete (
  $Roster: TicketManagement.Roster
)
begin
  $Response = call rest service post '{1}/rest/core/v1/rosters/delete?PublicID={2}' with (
    {1} = @CoreSeam.CoreBaseUrl,
    {2} = toString($Roster/PublicID)
  ) (
    Authentication: basic (Username: @CoreSeam.CoreAPIUserName, Password: @CoreSeam.CoreAPIPassword),
    Timeout: 30,
  ) returns String on error without rollback begin
    log error node 'CoreSeam' 'monolith roster delete {1} failed: {2}' with ({1} = toString($Roster/PublicID), {2} = $latestError/Message);
    show message 'The planner (FSM) could not be reached; the opening time was not deleted.' type Error blocking;
    return;
  end error;
  log info node 'CoreSeam' 'monolith roster delete: {1}' with ({1} = $Response);
  return;
end;
grant execute on microflow RosterManagement.ACT_Roster_Delete to RosterManagement.User;

drop microflow AssetManagement.AssetList_Delete;
create or modify microflow AssetManagement.AssetList_Delete (
  $AssetList: List of AssetManagement.Asset
)
folder 'Objects/Asset'
export level api
begin
  $NativeAssetList_ToDelete = create list of NativeMobileAsset.NativeAsset;
  $AssetPartList_ToDelete = create list of Part.AssetPart;
  loop $IteratorAsset in $AssetList
  begin
    $NativeAsset = call microflow NativeMobileAsset.NativeAsset_Get_BySystemID(SystemID = $IteratorAsset/SystemID, NativeAssetList_optional = empty);
    add $NativeAsset to $NativeAssetList_ToDelete;
    $RostersGone = call microflow CoreSeam.Rosters_DeleteRemoteForAsset(Asset = $IteratorAsset);
    retrieve $AssetPartList from $IteratorAsset/Part.AssetPart_Asset;
    add $AssetPartList to $AssetPartList_ToDelete;
  end loop;
  call microflow Part.AssetPartList_Delete(AssetPartList_ToDelete = $AssetPartList_ToDelete);
  call microflow NativeMobileAsset.NativeAssetList_Delete(NativeAssetList = $NativeAssetList_ToDelete);
  delete $AssetList refresh;
  return;
end;
drop microflow RosterManagement.RosterList_Delete;

-- ---------------------------------------------------------------- reads re-pointed
drop microflow AssetManagement.ACT_Asset_Delete;
create or modify microflow AssetManagement.ACT_Asset_Delete (
  $Asset: AssetManagement.Asset
)
folder 'Pages/Asset'
begin
  retrieve $TicketList from TicketManagement.Ticket where [TicketManagement.Ticket_Asset/TicketManagement.MonoAsset/SystemID = $Asset/SystemID];
  if $TicketList = empty then
    call microflow AssetManagement.Asset_Delete(Asset = $Asset);
    return;
  else
    show message 'This asset cannot de deleted, because it is associated to one or more tickets.' type Warning blocking;
    return;
  end if;
end;
grant execute on microflow AssetManagement.ACT_Asset_Delete to AssetManagement.EditAsset;

create or modify microflow AssetManagement.Asset_GetPreferredTechnician (
  $Asset: AssetManagement.Asset
)
returns Technician.Technician
folder 'Objects/Asset'
export level api
begin
  retrieve $Technician_Preferred from $Asset/AssetManagement.Asset_Technician_Preferred;
  return $Technician_Preferred;
end;

drop microflow AssetManagement.Asset_GetRelevantSLA;
create or modify microflow AssetManagement.Asset_GetRelevantSLA (
  $Asset: AssetManagement.Asset
)
returns TicketManagement.SLA
folder 'Objects/Asset'
export level api
begin
  retrieve $SLA_Asset from TicketManagement.SLA where [TicketManagement.SLA_Asset/TicketManagement.MonoAsset/SystemID = $Asset/SystemID] first;
  if $SLA_Asset != empty then
    return $SLA_Asset;
  end if;
  retrieve $Contract from $Asset/AssetManagement.Asset_Contract;
  if $Contract != empty then
    retrieve $SLA_Contract from TicketManagement.SLA where [TicketManagement.SLA_Contract/TicketManagement.Contract/PublicID = $Contract/PublicID] first;
    if $SLA_Contract != empty then
      return $SLA_Contract;
    end if;
  end if;
  retrieve $Umbrella from $Asset/AssetManagement.Asset_UmbrellaContract;
  if $Umbrella != empty then
    retrieve $SLA_Umbrella from TicketManagement.SLA where [TicketManagement.SLA_UmbrellaContract/TicketManagement.Contract/PublicID = $Umbrella/PublicID] first;
    if $SLA_Umbrella != empty then
      return $SLA_Umbrella;
    end if;
  end if;
  retrieve $Customer from $Asset/AssetManagement.Asset_Customer;
  if $Customer != empty then
    retrieve $SLA_Customer from TicketManagement.SLA where [TicketManagement.SLA_Customer/TicketManagement.Customer/PublicID = $Customer/PublicID] first;
    if $SLA_Customer != empty then
      return $SLA_Customer;
    end if;
  end if;
  -- FSM's last fallback: the Standard SLA. The published enumeration arrives as a String (Edm.String in $metadata).
  retrieve $SLA_Standard from TicketManagement.SLA where [SLAtype = 'Standard'] first;
  return $SLA_Standard;
end;

-- external objects cannot be changed; FSM only refreshed the work order in the client, and an external object is
-- re-read on every access, so these become no-ops (kept: the monolith's work-order pages still call them)
drop microflow Part.SuggestedPart_GetRefreshWorkOrder;
create or modify microflow Part.SuggestedPart_GetRefreshWorkOrder (
  $SuggestedPart: Part.SuggestedPart
)
folder 'Objects/SuggestedPart'
export level api
begin
  return;
end;
drop microflow Tool.SelectedTool_RefreshWorkOrder;
create or modify microflow Tool.SelectedTool_RefreshWorkOrder (
  $SelectedTool: Tool.SelectedTool
)
folder 'Objects/SelectedTool'
export level api
begin
  return;
end;

-- ---------------------------------------------------------------- stub views -> read-only pages on external data
