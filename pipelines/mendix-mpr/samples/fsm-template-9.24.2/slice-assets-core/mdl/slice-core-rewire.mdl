) {
  dataview dvLink (DataSource: $TechnicianLink) {
    textbox tbLinkName (Label: 'Technician', Attribute: TechnicianName, Editable: Never)
    combobox cbLinkAccount (Label: 'Slice account', Association: CoreSeam.TechnicianLink_Account, DataSource: database Administration.Account, CaptionAttribute: Name)
    footer {
      actionbutton btnSaveLink (Caption: 'Save', Action: save changes, ButtonStyle: Primary)
      actionbutton btnCancelLink (Caption: 'Cancel', Action: cancel changes)
    }
